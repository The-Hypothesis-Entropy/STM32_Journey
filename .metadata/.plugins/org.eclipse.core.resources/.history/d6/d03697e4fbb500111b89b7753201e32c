void mhal_dma_init(const mhal_dma_config_t *config){
	/*
	 * Configure a dma stream, leave it disabled
	 * -> Disable stream (EN=0)
	 * -> Wait for hardware acknowledgement
	 * -> Clear status flags for stream
	 * -> Write peripheral and memory addresses
	 * -> Write # of items to transfer
	 * -> Configure CR (direction, sizes, priority, mode)
	 * -> Leave EN=0
	 */

	DMA_Stream_TypeDef *stream = config->stream;

	//Disable stream
	stream->CR &= ~DMA_SxCR_EN;

	//Hardware takes few cycles to shutdown after the write
	while (stream->CR & DMA_SxCR_EN){}

	//Clear all flags
	mhal_dma_clear_flags(stream);

	//write peripheral and memory addresses
	stream->PAR = config->periph_addr;
	stream->M0AR = config->mem_addr;

	//write # of items to transfer
	stream->NDTR = config->length;

	//configure CR
	stream->CR |= DMA_SxCR_TCIE; //Transfer complete interrupt enable
	stream->CR |= DMA_SxCR_PFCTRL; //Peripheral controls flow

	stream->CR &= ~DMA_SxCR_DIR_Msk;
	stream->CR |= config->direction; //Data transfer direction

	stream->CR &= ~DMA_SxCR_CIRC_Msk;
	stream->CR |= config->circular; //Circular buffer?

	stream->CR &= ~DMA_SxCR_PINC_Msk;
	stream->CR |= config->periph_inc;//Peripheral increase?

	stream->CR &= ~DMA_SxCR_MINC_Msk;
	stream->CR |= config->mem_inc;//Memory increase?

	stream->CR &= ~DMA_SxCR_PSIZE_Msk;
	stream->CR |= config->periph_size;

	stream->CR &= ~DMA_SxCR_MSIZE_Msk;
	stream->CR |= config->circular;
}

