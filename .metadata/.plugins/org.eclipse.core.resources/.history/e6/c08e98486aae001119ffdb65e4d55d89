#include "mhal_gpio.h"
#include "stm32f4xx.h"

mhal_status_t mhal_gpio_enable_clock(GPIO_TypeDef *port){
	if (port==GPIOA)
		{RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
		return MHAL_OK;}
	else if (port==GPIOB)
		{RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;
		return MHAL_OK;}
	else if (port==GPIOC)
		{RCC->AHB1ENR |= RCC_AHB1ENR_GPIOCEN;
		return MHAL_OK;}
	else if (port==GPIOD)
		{RCC->AHB1ENR |= RCC_AHB1ENR_GPIODEN;
		return MHAL_OK;}
	else if (port==GPIOE)
		{RCC->AHB1ENR |= RCC_AHB1ENR_GPIOEEN;
		return MHAL_OK;}
	else if (port==GPIOH)
		{RCC->AHB1ENR |= RCC_AHB1ENR_GPIOHEN;
		return MHAL_OK;}
	else{
		return MHAL_ERROR;
	}
}




mhal_status_t mhal_gpio_init(GPIO_TypeDef *port, uint16_t pin, const mhal_gpio_config_t *config){
	//MODER
	mhal_gpio_enable_clock(port);
	port->MODER &= ~(0x03UL<<(pin*2));
	port->MODER |= ((config->mode)<<(pin*2));

	//OTYPER
	port->OTYPER &= ~(0x01UL<<pin);
	port->OTYPER |= config->type;

	//OSPEEDR
	port->OSPEEDR &= ~(0x03UL<<(pin*2));
	port->OSPEEDR |= ((config->speed)<<(pin*2));

	//PUPDR
	port->PUPDR &= ~(0x03UL<<(pin*2));
	port->PUPDR |= ((config->pull)<<(pin*2));

}

mhal_status_t mhal_gpio_write(GPIO_TypeDef *port, uint16_t pin, uint8_t value){
	port->BSRR = value ? (0x01UL<<pin) : ((0x01UL)<<(pin+16));
}







