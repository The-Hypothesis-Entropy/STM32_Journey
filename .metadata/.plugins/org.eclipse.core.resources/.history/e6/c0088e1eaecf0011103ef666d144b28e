//PERIPHERAL ACCESS AND CONTROL

void ET_GPIO_write(uint8_t *gpio_settings){
/*
 * ARRAY: [PORT LETTER][GPIO NUM][VALUE]
 */
	GPIO_TypeDef *port;
	if(gpio_settings[0]=='B'){port = GPIOB;}
	else if(gpio_settings[0]=='C'){port = GPIOC;}
	else if(gpio_settings[0]=='D'){port = GPIOD;}
	else{port = GPIOA;}

	HAL_GPIO_WritePin(port, (uint16_t)(0x0001<<gpio_settings[1]), gpio_settings[2]);
}

uint8_t ET_GPIO_read(uint8_t *gpio_settings){
/*
 * ARRAY: [PORT LETTER][GPIO NUM]
 */
	GPIO_TypeDef *port;
	if(gpio_settings[0]=='B'){port = GPIOB;}
	else if(gpio_settings[0]=='C'){port = GPIOC;}
	else if(gpio_settings[0]=='D'){port = GPIOD;}
	else{port = GPIOA;}

	return HAL_GPIO_ReadPin(port, (uint16_t)(0x0001<<gpio_settings[1]));
}


void ET_UART_send(uint8_t *param){
/*
 * ARRAY: [UART NUM][LENGTH OF DATA][DATA begin]...[DATA end]
 */

	USART_TypeDef *uart = (param[0]==1U) ? USART1 : (param[0] == 2U) ? USART2 : USART6;
	for(uint16_t i = 0; i<param[1]; i++){
		while(!(uart->SR & USART_SR_TXE)){}
		uart->DR = param[i+2];
	}
}
