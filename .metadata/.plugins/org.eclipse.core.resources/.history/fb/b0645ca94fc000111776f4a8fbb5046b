  /* Initialize all configured peripherals */

  /* USER CODE BEGIN 2 */

  mhal_spi_master_device(SPI2, PC4);

  ST7735_Init(); //Initialize the screen
  ST7735_FillRect(0, 0, 128, 128, ST7735_BLACK);
  ST7735_FillRect(44, 90, 40, 6, ST7735_CYAN);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    //---------STATE 1: EYES OPEN----------
    ST7735_FillRect(25, 35, 24, 30, ST7735_CYAN); //Left Eye Open
    ST7735_FillRect(79, 35, 24, 30, ST7735_CYAN); //Right Eye Open

    mhal_delay(3000); //eyes remain open for 3 seconds


    //---------STATE 2: BLINK-------------
    //overwrite open eyes with background color
    ST7735_FillRect(25, 35, 24, 30, ST7735_BLACK);
    ST7735_FillRect(79, 35, 24, 30, ST7735_BLACK);

    //Draw blink slits
    ST7735_FillRect(25, 48, 24, 4, ST7735_CYAN);
    ST7735_FillRect(79, 48, 24, 4, ST7735_CYAN);

    mhal_delay(50);

    //Clear slits before looping back to open state
    ST7735_FillRect(25, 48, 24, 4, ST7735_BLACK);
    ST7735_FillRect(79, 48, 24, 4, ST7735_BLACK);

    //mhal_gpio_toggle(PA5);
    //mhal_delay(200);
  }
  /* USER CODE END 3 */
