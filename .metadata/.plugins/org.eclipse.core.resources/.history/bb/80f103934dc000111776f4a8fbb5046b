#include <stdint.h>
#include "mhal.h"
#include "mhal_globals.h"
#include "st7735.h"

#define EYE_LEFT_X 25
#define EYE_RIGHT_X 79
#define EYE_WIDTH 24
#define EYE_CENTER_Y 50
#define EYE_HEIGHT_OPEN 30
#define EYE_HEIGHT_HALF 18
#define EYE_HEIGHT_NARROW 8
#define EYE_HEIGHT_CLOSED 4

#define EYE_COLOR ST7735_CYAN
#define BACKGROUND_COLOR ST7735_BLACK

//Change both eyes from current_height to target_height
static void Eyes_SetHeight(uint8_t current_height, uint8_t target_height){
	const uint8_t eye_x_positions[2] = {EYE_LEFT_X, EYE_RIGHT_X};
	for (int eye_index=0; eye_index<2; eye_index++){
		uint8_t eye_x = eye_x_positions[eye_index];

		if(target_height<current_height){
			//closing:
			uint8_t strip_height = (current_height - target_height)/2;
			uint8_t top_strip_y = EYE_CENTER_Y - current_height/2;
			uint8_t bottom_strip_y = EYE_CENTER_Y + target_height/2;

			ST7735_FillRect(eye_x, top_strip_y, EYE_WIDTH, strip_height, BACKGROUND_COLOR);
			ST7735_FillRect(eye_x, bottom_strip_y, EYE_WIDTH, strip_height, BACKGROUND_COLOR);
		}
		else{ //opening: paint a strip at the bottom ant at the top
			uint8_t strip_height = (target_height - current_height) / 2;
			uint8_t top_strip_y = EYE_CENTER_Y - target_height/2;
			uint8_t bottom_strip_y = EYE_CENTER_Y + current_height/2;

			ST7735_FillRect(eye_x, top_strip_y, EYE_WIDTH, strip_height, EYE_COLOR);
			ST7735_FillRect(eye_x, bottom_strip_y, EYE_WIDTH, strip_height, EYE_COLOR);

		}
	}
}

static void Eyes_Blink(void){
	Eyes_SetHeight(EYE_HEIGHT_OPEN, EYE_HEIGHT_HALF);
	Eyes_SetHeight(EYE_HEIGHT_HALF, EYE_HEIGHT_NARROW);
	Eyes_SetHeight(EYE_HEIGHT_NARROW, EYE_HEIGHT_CLOSED);
	mhal_delay(80);
	Eyes_SetHeight(EYE_HEIGHT_CLOSED, EYE_HEIGHT_NARROW);
	Eyes_SetHeight(EYE_HEIGHT_NARROW, EYE_HEIGHT_HALF);
	Eyes_SetHeight(EYE_HEIGHT_HALF, EYE_HEIGHT_OPEN);
}












