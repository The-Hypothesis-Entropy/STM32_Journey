	 */
	GPIO_TypeDef *gpio = (gpio_config[1] == 'A') ? GPIOA :
						 (gpio_config[1] == 'B') ? GPIOB : GPIOC;
	GPIO_InitTypeDef gpio={0};
	gpio.Pin = 0;
}

