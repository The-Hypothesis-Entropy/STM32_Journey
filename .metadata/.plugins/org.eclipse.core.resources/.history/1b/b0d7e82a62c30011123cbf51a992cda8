void mhal_tim_pwm_chn_prld_mode_cfg(TIM_TypeDef *tim, mhal_tim_channel_t channel){
	//* Configure channel of tim to be output and enable preload register
	//* Preload register means an update to ccrx is buffered
	//* The new ccrx is enforced on the next timer cycle after uev generated.
	//* Set pwm mode-OCxM as mode 1 (110)

	if(channel < 2U){
		if(channel == MHAL_TIM_CH1){
			tim->CCMR1 &= ~(TIM_CCMR1_CC1S | TIM_CCMR1_OC1M_Msk); //chn1 set as output, clear pwm mode field
			tim->CCMR1 |= (TIM_CCMR1_OC1PE | 0x6UL<<4U); //chn1 preload register enabled, pwm mode 1 set
		}
		else{
			tim->CCMR1 &= ~(TIM_CCMR1_CC2S | TIM_CCMR1_OC2M_Msk); //chn2 set as output, clear pwm mode field
			tim->CCMR1 |= (TIM_CCMR1_OC2PE | 0x6UL<<12U); //chn2 preload register enabled, pwm mode 1 set
		}
	}
	else{
		if(channel == MHAL_TIM_CH3){
			tim->CCMR2 &= ~(TIM_CCMR2_CC3S | TIM_CCMR2_OC3M_Msk); //chn3 set as output, clear pwm mode field
			tim->CCMR2 |= (TIM_CCMR2_OC3PE | 0x6UL<<4U); //chn3 preload register enabled, pwm mode 1 set
		}
		else{
			tim->CCMR2 &= ~(TIM_CCMR2_CC4S | TIM_CCMR2_OC4M_Msk); //chn4 set as output, clear pwm mode field
			tim->CCMR2 |= (TIM_CCMR2_OC4PE | 0x6UL<<12U); //chn4 preload register enabled, pwm mode 1 set

		}
	}


}

void mhal_tim_pwm_set_duty(TIM_TypeDef *tim, mhal_tim_channel_t channel, uint32_t duty){
//resolution can be improved here!
	if (duty>=128)duty = 128;
	if (duty<0)duty = 0;

	duty = (duty*((tim->ARR) + 1))>>7U;
	switch(channel){
	case MHAL_TIM_CH1:
		tim->CCR1 = duty;
		break;
	case MHAL_TIM_CH2:
		tim->CCR2 = duty;
		break;
	case MHAL_TIM_CH3:
		tim->CCR3 = duty;
		break;
	case MHAL_TIM_CH4:
		tim->CCR4 = duty;
		break;
	}
	tim->EGR |= TIM_EGR_UG; //generate uev to load new duty
	tim->SR &= ~TIM_SR_UIF;
}

void mhal_tim_pwm_channel_output_enable(TIM_TypeDef *tim, mhal_tim_channel_t channel){
	// To make signal output on the corresponding output pin
	switch(channel){
		case MHAL_TIM_CH1:
			tim->CCER |= TIM_CCER_CC1E;
			break;
		case MHAL_TIM_CH2:
			tim->CCER |= TIM_CCER_CC2E;
			break;
		case MHAL_TIM_CH3:
			tim->CCER |= TIM_CCER_CC3E;
			break;
		case MHAL_TIM_CH4:
			tim->CCER |= TIM_CCER_CC4E;
			break;
		}
}

void mhal_tim_pwm_set_freq(TIM_TypeDef *tim, uint32_t frequency){
	mhal_tim_arr_psc_resolution(tim, mhal_tim_get_clock(tim), frequency);
}

//---------------------------------------------------------------------------

void mhal_tim_pwm_init(TIM_TypeDef *tim, const mhal_tim_pwm_config_t *config){
	/*
	 * Configure timer, channel, duty. Doesn't start counting
	 */
	//Enable the timer's clock
	mhal_tim_enable_clock(tim);

	//Read timer's input clock frequency
	uint32_t tim_clk = mhal_tim_get_clock(tim);

	//Stop the timer
	tim->CR1 &= ~TIM_CR1_CEN;

	//Calculate and assign arr, psc
	mhal_tim_arr_psc_resolution(tim, tim_clk, config->frequency_hz);

	//Configure channel as output-CCxS, and enable preload-OCxPE (to avoid glitches)
	mhal_tim_pwm_chn_prld_mode_cfg(tim, config->channel);

	//write duty cycle-CCRx
	mhal_tim_pwm_set_duty(tim, config->channel, config->duty);

	//Enable channel output-CCER.CCxE
	mhal_tim_pwm_channel_output_enable(tim, config->channel);

	if(tim==TIM1){//for TIM1, enable main output
		tim->BDTR |= TIM_BDTR_MOE;
	}

	//Set ARPE to ensure arr is buffered as well. no glitches.
	tim->CR1 |= TIM_CR1_ARPE;

	//Force update event to load shadow registers
	tim->EGR |= TIM_EGR_UG;

	//Clear UIF created by previous step
	tim->SR &= ~(TIM_SR_UIF);
}

void mhal_tim_pwm_start(TIM_TypeDef *tim){
	tim->CR1 |= TIM_CR1_CEN;
}

void mhal_tim_pwm_stop(TIM_TypeDef *tim){
	tim->CR1 &= ~TIM_CR1_CEN;
}

void mhal_tim_pwm_cfg(TIM_TypeDef *tim, const char *pin, mhal_tim_channel_t channel, mhal_gpio_alt_fn_t af, uint32_t frequency, uint32_t duty){
	/*
	 * Use this first, then you are free to start and stop the timer,
	 * 		or to change duty cycle and frequency as you wish
	 */

	//Pin configuration
	GPIO_TypeDef *port;
	uint16_t pin_num;

	port = mhal_dename_port(pin);
	pin_num = mhal_dename_pin(pin);
	mhal_gpio_config_t my_config = MHAL_GPIO_CFG_AF;
	my_config.af = af;
	mhal_gpio_init(port, pin_num, &my_config);

	//Pwm configuration
	mhal_tim_pwm_config_t pwm_cfg = {.frequency_hz = frequency, .channel = channel, .duty = duty};
	mhal_tim_pwm_init(tim, &pwm_cfg);

}



