#include "stm32f401xe.h"

int mainmain(){
	//Enable the power to GPIOA
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOCEN;

	//Config PA5
	GPIOA->MODER |= 0x01<<10;

	//Config PC13


	while(1){
		if(GPIOC->IDR & 0x01<<13){
			GPIOA->BSRR = 0x01<<5;
		}
		else{
			GPIOA->BSRR = 0x01<<(5+16);
		}
	}
}

int main(){
	//Activate GPIOB
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;

	//Configure PB3
	GPIOB->MODER &= ~(0x11<<6);
	GPIOB->MODER |= 0x01<<6;

	GPIOB->OTYPER |= 0x01<<3;

	//Pull PB3 low
	GPIOB->BSRR = 0x01<<(3+16);
}
