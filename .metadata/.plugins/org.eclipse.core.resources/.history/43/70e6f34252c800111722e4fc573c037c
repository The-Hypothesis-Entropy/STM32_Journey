#include "st7735.h"

static void command_mode(display_device_t display){
	HAL_GPIO_WritePin(display.dc_port, display.dc_pin, 0); //command
}

static void data_mode(display_device_t display){
	HAL_GPIO_WritePin(display.dc_port, display.dc_pin, 1); //command
}

static void hardware_reset(display_device_t display){
	HAL_GPIO_WritePin(display.res_port, display.res_pin, 0);
	HAL_Delay(50);
	HAL_GPIO_WritePin(display.res_port, display.res_pin, 1);
	HAL_Delay(120);
}

static void writecmd(display_device_t display, uint8_t cmd){
	command_mode(display);
	HAL_SPI_Transmit(&display.hspi, &cmd, 1, 100);
}

static void writedata(display_device_t display, uint8_t data){
	data_mode(display);
	HAL_SPI_Transmit(&display.hspi, &data, 1, 100);
}

display_device_t display_init(SPI_HandleTypeDef HSPI, GPIO_TypeDef *cs_port, uint8_t cs_pin, GPIO_TypeDef *res_port, uint8_t res_pin, GPIO_TypeDef *dc_port, uint8_t dc_pin, GPIO_TypeDef *blk_port, uint8_t blk_pin, uint16_t screen_width, uint16_t screen_height){
	/*
	 * SPI MUST BE CONFIGURED ALREADY
	 */
	//Init display struct
	display_device_t display;
	display.hspi = HSPI;
	display.cs_port = cs_port;
	display.res_port = res_port;
	display.dc_port = dc_port;
	display.blk_port = blk_port;
	display.cs_pin = cs_pin;
	display.res_pin = res_pin;
	display.dc_pin = dc_pin;
	display.blk_pin = blk_pin;
	display.width = screen_width;
	display.height = screen_height;

	//GPIO Initialization
	GPIO_InitTypeDef gpio = {0};
	gpio.Pin = cs_pin;
	gpio.Mode = GPIO_MODE_OUTPUT_PP;
	gpio.Pull = GPIO_NOPULL;
	gpio.Speed = GPIO_SPEED_FREQ_HIGH;
	gpio.Alternate = 0;
	HAL_GPIO_Init(cs_port, &gpio);
	gpio.Pin = res_pin;
	HAL_GPIO_Init(res_port, &gpio);
	gpio.Pin = dc_pin;
	HAL_GPIO_Init(dc_port, &gpio);
	gpio.Pin = blk_pin;
	HAL_GPIO_Init(blk_port, &gpio);

	//Run initialization sequence
	hardware_reset(display);
	writecmd(display, 0x01); //software reset
	HAL_Delay(150);

	writecmd(display, 0x11); //sleep out
	HAL_Delay(200);

	writecmd(display, 0xC0); //Power control 1
	writedata(display, 0xA2); writedata(display, 0x02); writedata(display, 0x84);

	writecmd(display, 0xC1); //Power control 2
	writedata(display, 0xC5);

	writecmd(display, 0xC2); //Power control 2
	writedata(display, 0x0A); writedata(display, 0x00);

	writecmd(display, 0xC3); //Power control 2
	writedata(display, 0x0A); writedata(display, 0x00);

	writecmd(display, );
	writedata(display, );





	return display;
}
