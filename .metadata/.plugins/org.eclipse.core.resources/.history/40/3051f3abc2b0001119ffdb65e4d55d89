void mhal_tim_base_start(TIM_TypeDef *tim){ //start or continue. hasnt wiped CNT
	tim->CR1 |= TIM_CR1_CEN;
}

void mhal_tim_base_stop(TIM_TypeDef *tim){
	tim->CR1 &= ~TIM_CR1_CEN;
}

void mhal_tim_enable_update_irq(TIM_TypeDef *tim, uint8_t priority){
	/*
	 * THREE GATES FOR THE INTERRUPT PATH
	 * 1. UDIS (CR1): Do update events get generated?
	 * 2. UIE (DIER): Does a generated update event send request to NVIC?
	 * 3. NVIC: should cpu ccare about this? and how urgently?
	 */
	tim->CR1 &= ~TIM_CR1_UDIS; //UEV will be generated, thus UIF will be set
	tim->SR &= ~TIM_SR_UIF; //incase flag had been set (for UEVs) prior to uie on
	tim->DIER |= TIM_DIER_UIE;
	IRQn_Type num=100; //just a random number as a guard
	if(tim==TIM1)num=TIM1_UP_TIM10_IRQn; //for TIM1 update
#ifdef TIM9
	else if(tim==TIM9)num=TIM1_BRK_TIM9_IRQn; //for TIM9 global interrupt
#endif
#ifdef TIM10
	else if(tim==TIM10)num=TIM1_UP_TIM10_IRQn; //for TIM10 global interrupt
#endif
#ifdef TIM2
	else if(tim==TIM2)num=TIM2_IRQn;
#endif
#ifdef TIM3
	else if(tim==TIM3)num=TIM3_IRQn;
#endif
#ifdef TIM4
	else if(tim==TIM4)num=TIM4_IRQn;
#endif
#ifdef TIM5
	else if(tim==TIM5)num=TIM5_IRQn;
#endif
#ifdef TIM11
	else if(tim==TIM11)num=TIM1_TRG_COM_TIM11_IRQn; //TIM11 global shared
#endif
	if(num!=100){
	if(priority>15U)priority=15U;
	NVIC_SetPriority(num, priority);
	NVIC_EnableIRQ(num);
	}
}

void mhal_tim_disable_update_irq(TIM_TypeDef *tim){
	tim->DIER &= ~TIM_DIER_UIE; //no interrupt request per UEV
}

void mhal_tim_clear_update_flag(TIM_TypeDef *tim){
	tim->SR &= ~TIM_SR_UIF;
}

