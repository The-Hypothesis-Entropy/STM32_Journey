#include "main.h"
#include "cmsis_os.h"
#include "mhal.h"
#include "stdio.h"
#include "st7735.h"
#include "peripherals.h"


int main(){
	Begin();
	SPI_HandleTypeDef hspi = spi_init(SPI2);
	display_device_t display = display_init(hspi, GPIOC, GPIO_PIN_4, GPIOB, GPIO_PIN_1, GPIOB, GPIO_PIN_2, 128U, 128U);

	display_FillRect(display, 0, 0, 50, 128, ST7735_CYAN);
	while(1){
		mhal_uart_write(USART2, (uint8_t *)"hello boy!\r\n", 12);
		HAL_Delay(500);
	}

}

