#include "dht.h"

dht_status_t dht_init(GPIO_TypeDef *port, uint8_t pin){
	//start delay will be done precisely by vTaskDelay before this function is called
	//Hardware Preparation
	mhal_delay_ms(1000);

	//Start condition
	mhal_gpio_init(dht_port, dht_pin, &MHAL_GPIO_CFG_OUTPUT_OD);
	mhal_gpio_write(dht_port, dht_pin, 0);
	mhal_delay_ms(18);

	//Confirm sync
	mhal_gpio_value_t sync_one, sync_two;
	mhal_delay_us(5);
	sync_one = mhal_gpio_read(port, pin);
	mhal_delay_us(80);
	sync_two = mhal_gpio_read(port, pin);
	if(!(sync_one==MHAL_GPIO_LOW && sync_two==MHAL_GPIO_HIGH)){
		return SYNC_TIMEOUT;
	}

	//Read values
	mhal_gpio_init(dht_port, dht_pin, &MHAL_GPIO_CFG_INPUT_OD);

}
