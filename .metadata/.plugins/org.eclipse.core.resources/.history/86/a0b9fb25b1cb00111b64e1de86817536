static TIM_HandleTypeDef *htim = NULL;

/* 2. Init function (fills the struct) */
void tim_base_init(TIM_TypeDef *tim, uint32_t freq_hz) {
	IRQn_Type irqn;
	if(tim==TIM1){
		__HAL_RCC_TIM1_CLK_ENABLE();
		htim = &htim1;
		htim->Instance = TIM1;
		irqn = TIM1_UP_TIM10_IRQn;
	}
	if(tim==TIM2){
		__HAL_RCC_TIM2_CLK_ENABLE();
		htim = &htim2;
		htim->Instance = TIM2;
		irqn = TIM2_IRQn;
		}
	if(tim==TIM3){
		__HAL_RCC_TIM3_CLK_ENABLE();
		htim = &htim3;
		htim->Instance = TIM3;
		irqn = TIM3_IRQn;
		}
	if(tim==TIM4){
		__HAL_RCC_TIM4_CLK_ENABLE();
		htim = &htim4;
		htim->Instance = TIM4;
		irqn = TIM4_IRQn;
		}
	if(tim==TIM5){
		__HAL_RCC_TIM5_CLK_ENABLE();
		htim = &htim5;
		htim->Instance = TIM5;
		irqn = TIM5_IRQn;
		}

    htim->Init.Prescaler = (SystemCoreClock / freq_hz) / 65536;
    htim->Init.Period = (SystemCoreClock / (freq_hz * (htim->Init.Prescaler + 1))) - 1;

    HAL_TIM_Base_Init(htim);
    HAL_NVIC_EnableIRQ(irqn);
    HAL_TIM_Base_Start_IT(htim);
}

void tim_base_change_freq(TIM_TypeDef *tim, uint32_t freq_hz) {
    // 1. Determine the actual clock feeding the timer
    uint32_t tim_clk;
    if (tim == TIM1 || tim == TIM9 || tim == TIM10 || tim == TIM11) {
        // APB2 Timer
        tim_clk = HAL_RCC_GetPCLK2Freq();
        if ((RCC->CFGR & RCC_CFGR_PPRE2) != RCC_CFGR_PPRE2_DIV1) {
            tim_clk *= 2; // Doubling rule
        }
    } else {
        // APB1 Timer
        tim_clk = HAL_RCC_GetPCLK1Freq();
        if ((RCC->CFGR & RCC_CFGR_PPRE1) != RCC_CFGR_PPRE1_DIV1) {
            tim_clk *= 2; // Doubling rule
        }
    }

    // 2. Calculate new values
    uint32_t total_ticks = tim_clk / freq_hz;
    uint32_t psc = (total_ticks > 65536) ? (total_ticks / 65536) : 0;
    uint32_t arr = (total_ticks / (psc + 1)) - 1;

    // 3. Get the handle
    htim = (tim==TIM1) ? &htim1 : ((tim==TIM2) ? &htim2 : ((tim==TIM3) ? &htim3 : ((tim==TIM4) ? &htim4 : &htim5)));

    // 4. Write them to the hardware
    __HAL_TIM_SET_PRESCALER(htim, psc);
    __HAL_TIM_SET_AUTORELOAD(htim, arr);

    // 5. Force an immediate update so the new values take effect now
    tim->EGR = TIM_EGR_UG;
}


void tim_pwm_init(TIM_TypeDef *tim, uint32_t channel, uint32_t freq_hz, uint8_t duty_percent){
    // 1. Init gpio and clock

    if(tim==TIM1){
    	__HAL_RCC_TIM1_CLK_ENABLE();
    	switch(channel){
    	case TIM_CHANNEL_2:
    		__HAL_RCC_GPIOA_CLK_ENABLE();
    		gpio_af_pp_init(GPIOA, GPIO_PIN_9, 1);
    	    break;
    	case TIM_CHANNEL_3:
    		__HAL_RCC_GPIOA_CLK_ENABLE();
    		gpio_af_pp_init(GPIOA, GPIO_PIN_10, 1);
    	    break;
    	case TIM_CHANNEL_4:
    		__HAL_RCC_GPIOA_CLK_ENABLE();
    		gpio_af_pp_init(GPIOA, GPIO_PIN_11, 1);
    	    break;
    	default:
    		__HAL_RCC_GPIOA_CLK_ENABLE();
    		gpio_af_pp_init(GPIOA, GPIO_PIN_8, 1);
    	    break;
    	}
    }
    if(tim==TIM2){
    	__HAL_RCC_TIM2_CLK_ENABLE();
    	switch(channel){
    	case TIM_CHANNEL_2:
    		__HAL_RCC_GPIOB_CLK_ENABLE();
    		gpio_af_pp_init(GPIOB, GPIO_PIN_3, 1);
    	    break;
    	case TIM_CHANNEL_3:
    		__HAL_RCC_GPIOB_CLK_ENABLE();
    		gpio_af_pp_init(GPIOB, GPIO_PIN_10, 1);
    	    break;
    	case TIM_CHANNEL_4:
    		__HAL_RCC_GPIOB_CLK_ENABLE();
    		gpio_af_pp_init(GPIOB, GPIO_PIN_11, 1);
    	    break;
    	default:
    		__HAL_RCC_GPIOA_CLK_ENABLE();
    		gpio_af_pp_init(GPIOA, GPIO_PIN_5, 1);
    	    break;
    	}
    }
    if(tim==TIM3){
    	__HAL_RCC_TIM3_CLK_ENABLE();
    	switch(channel){
    	case TIM_CHANNEL_2:
    		__HAL_RCC_GPIOC_CLK_ENABLE();
    		gpio_af_pp_init(GPIOC, GPIO_PIN_7, 2);
    	    break;
    	case TIM_CHANNEL_3:
    		__HAL_RCC_GPIOC_CLK_ENABLE();
    		gpio_af_pp_init(GPIOC, GPIO_PIN_8, 2);
    	    break;
    	case TIM_CHANNEL_4:
    		__HAL_RCC_GPIOC_CLK_ENABLE();
    		gpio_af_pp_init(GPIOC, GPIO_PIN_9, 2);
    	    break;
    	default:
    		__HAL_RCC_GPIOC_CLK_ENABLE();
    		gpio_af_pp_init(GPIOC, GPIO_PIN_6, 2);
    	    break;
    	}
    }
    if(tim==TIM4){
    	__HAL_RCC_TIM4_CLK_ENABLE();
    	switch(channel){
    	case TIM_CHANNEL_2:
    		__HAL_RCC_GPIOB_CLK_ENABLE();
    		gpio_af_pp_init(GPIOB, GPIO_PIN_7, 2);
    	    break;
    	case TIM_CHANNEL_3:
    		__HAL_RCC_GPIOB_CLK_ENABLE();
    		gpio_af_pp_init(GPIOB, GPIO_PIN_8, 2);
    	    break;
    	case TIM_CHANNEL_4:
    		__HAL_RCC_GPIOB_CLK_ENABLE();
    		gpio_af_pp_init(GPIOB, GPIO_PIN_9, 2);
    	    break;
    	default:
    		__HAL_RCC_GPIOB_CLK_ENABLE();
    		gpio_af_pp_init(GPIOB, GPIO_PIN_6, 2);
    	    break;
    	}
    }
    if(tim==TIM5){
    	__HAL_RCC_TIM5_CLK_ENABLE();
    	switch(channel){
    	case TIM_CHANNEL_2:
    		__HAL_RCC_GPIOA_CLK_ENABLE();
    		gpio_af_pp_init(GPIOA, GPIO_PIN_1, 2);
    	    break;
    	case TIM_CHANNEL_3:
    		__HAL_RCC_GPIOA_CLK_ENABLE();
    		gpio_af_pp_init(GPIOA, GPIO_PIN_2, 2);
    	    break;
    	case TIM_CHANNEL_4:
    		__HAL_RCC_GPIOA_CLK_ENABLE();
    		gpio_af_pp_init(GPIOA, GPIO_PIN_3, 2);
    	    break;
    	default:
    		__HAL_RCC_GPIOA_CLK_ENABLE();
    		gpio_af_pp_init(GPIOA, GPIO_PIN_0, 2);
    	    break;
    	}
    }

	// 2. Calculate Base Timer values
    uint32_t total_ticks = ((tim == TIM1 || tim == TIM9 || tim == TIM10 || tim == TIM11) ? (HAL_RCC_GetPCLK2Freq() * (((RCC->CFGR & RCC_CFGR_PPRE2) == RCC_CFGR_PPRE2_DIV1) ? 1 : 2)) : (HAL_RCC_GetPCLK1Freq() * (((RCC->CFGR & RCC_CFGR_PPRE1) == RCC_CFGR_PPRE1_DIV1) ? 1 : 2))) / freq_hz;
    uint32_t psc = (total_ticks > 65536) ? (total_ticks / 65536) : 0;
    uint32_t arr = (total_ticks / (psc + 1)) - 1;

    htim = (tim==TIM1) ? &htim1 : ((tim==TIM2) ? &htim2 : ((tim==TIM3) ? &htim3 : ((tim==TIM4) ? &htim4 : &htim5)));
    // 3. Configure the Base Timer
    htim->Instance = tim;
    htim->Init.Prescaler = psc;
    htim->Init.Period = arr;
    htim->Init.CounterMode = TIM_COUNTERMODE_UP;
    htim->Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_ENABLE;
    HAL_TIM_PWM_Init(htim);

    // 4. Configure the PWM Channel
    TIM_OC_InitTypeDef sConfigOC = {0};
    sConfigOC.OCMode = TIM_OCMODE_PWM1;
    sConfigOC.OCPolarity = TIM_OCPOLARITY_HIGH;

    // Calculate the exact tick count for the requested duty cycle
    // Example: 50% duty on a 1000-tick timer -> Pulse = 500
    sConfigOC.Pulse = ((arr + 1) * duty_percent) / 100;

    // 5. Apply config and start
    HAL_TIM_PWM_ConfigChannel(htim, &sConfigOC, channel);
    HAL_TIM_PWM_Start(htim, channel);
}

void tim_pwm_change_duty(TIM_TypeDef *tim, uint32_t channel, uint8_t duty_percent) {
    // 1. Clamp duty to 100% max
    if (duty_percent > 100) duty_percent = 100;

    // 2. Get the correct handle
    TIM_HandleTypeDef *htim = (tim==TIM1) ? &htim1 :
                              (tim==TIM2) ? &htim2 :
                              (tim==TIM3) ? &htim3 :
                              (tim==TIM4) ? &htim4 : &htim5;

    // 3. Read the current Auto-Reload value
    uint32_t arr = __HAL_TIM_GET_AUTORELOAD(htim);

    // 4. Calculate the new pulse width
    // We add 1 to ARR because the timer counts from 0 to ARR inclusive.
    uint32_t pulse = ((arr + 1) * duty_percent) / 100;

    // 5. Apply the new duty cycle
    __HAL_TIM_SET_COMPARE(htim, channel, pulse);
}

void tim_pwm_change_freq(TIM_TypeDef *tim, uint32_t channel, uint32_t freq_hz) {
    // 1. Get the handle
    TIM_HandleTypeDef *htim = (tim==TIM1) ? &htim1 :
                              (tim==TIM2) ? &htim2 :
                              (tim==TIM3) ? &htim3 :
                              (tim==TIM4) ? &htim4 : &htim5;

    // 2. Determine the actual clock feeding the timer
    uint32_t tim_clk;
    if (tim == TIM1 || tim == TIM9 || tim == TIM10 || tim == TIM11) {
        tim_clk = HAL_RCC_GetPCLK2Freq();
        if ((RCC->CFGR & RCC_CFGR_PPRE2) != RCC_CFGR_PPRE2_DIV1) tim_clk *= 2;
    } else {
        tim_clk = HAL_RCC_GetPCLK1Freq();
        if ((RCC->CFGR & RCC_CFGR_PPRE1) != RCC_CFGR_PPRE1_DIV1) tim_clk *= 2;
    }

    // 3. Calculate new Prescaler and Period (ARR)
    uint32_t total_ticks = tim_clk / freq_hz;
    uint32_t psc = (total_ticks > 65536) ? (total_ticks / 65536) : 0;
    uint32_t new_arr = (total_ticks / (psc + 1)) - 1;

    // 4. Save the current duty cycle as a percentage before we destroy the old ARR
    uint32_t old_arr = __HAL_TIM_GET_AUTORELOAD(htim);
    uint32_t old_ccr = __HAL_TIM_GET_COMPARE(htim, channel);

    // 5. Apply the new frequency
    __HAL_TIM_SET_PRESCALER(htim, psc);
    __HAL_TIM_SET_AUTORELOAD(htim, new_arr);

    // 6. Calculate the new CCR to maintain the exact same duty cycle
    if (old_arr > 0) {
        // Math: new_ccr = (old_ccr / old_period) * new_period
        uint32_t new_ccr = (old_ccr * (new_arr + 1)) / (old_arr + 1);
        __HAL_TIM_SET_COMPARE(htim, channel, new_ccr);
    }

    // 7. Force an immediate update so the new frequency takes effect now
    tim->EGR = TIM_EGR_UG;
}

