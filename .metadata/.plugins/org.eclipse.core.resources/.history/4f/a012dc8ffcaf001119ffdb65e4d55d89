#include "stm32f401xe.h"
#include "mhal_exti.h"
#include "mhal_gpio.h"


/*
 * ACTIVITY ON GPIO -> SYSCFG (ROUTING) -> EXTI (EDGE DETECTION) -> NVIC (PRIORITY) -> CPU CORE (ISR)
 * SYSCFG: Which port is EXTI line x watching? (PAx, PBx, PCx, PDx, PEx, PHx?)
 * EXTI: What are we watching for (rise or fall) and has it happened?
 * NVIC: Should cpu care about this? and if so, how urgently?
 */

/*----------------------------------------------
 *                    SYSCFG
 ----------------------------------------------*/

// Enable SYSCFG
void mhal_syscfg_enable(){
	RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN;
}

// Route GPIO Port to SYSCFG
void mhal_syscfg_route(const char *pin){
	uint8_t port_ref = pin[1] - 'A';
	uint8_t pin_ref = pin[2] - '0';
	GPIO_TypeDef *port = {};

	uint32_t mask = SYSCFG_EXTICR1_EXTI0_Msk;
	uint32_t port_config, syscfg_reg_num;
	uint8_t reg_pos;

	// Get port configuration
	switch(port_ref){
		case 0:
			port_config = SYSCFG_EXTICR1_EXTI0_PA;
			break;
		case 1:
			port_config = SYSCFG_EXTICR1_EXTI0_PB;
			break;
		case 2:
			port_config = SYSCFG_EXTICR1_EXTI0_PC;
			break;
		case 3:
			port_config = SYSCFG_EXTICR1_EXTI0_PD;
			break;
		case 4:
			port_config = SYSCFG_EXTICR1_EXTI0_PE;
			break;
		case 5:
			port_config = SYSCFG_EXTICR1_EXTI0_PH;
			break;
			};

	// Get pin (register and position) configuration
	syscfg_reg_num = (pin_ref<4) ? 0 : ((pin_ref<8) ? 1 : ((pin_ref<12) ? 2 : 3));
	reg_pos = pin_ref & 3U; //pin_ref % 4U

	// Configure
	SYSCFG->EXTICR[syscfg_reg_num] &= ~(mask<<reg_pos);
	SYSCFG->EXTICR[syscfg_reg_num] |= (port_config<<reg_pos);
}

/*----------------------------------------------
 *                    EXTI
 * - Unmask Line of Interest
 * - Select Trigger
 * - Once trigger is selected, pending bit will be active when activity occurs
 ----------------------------------------------*/

