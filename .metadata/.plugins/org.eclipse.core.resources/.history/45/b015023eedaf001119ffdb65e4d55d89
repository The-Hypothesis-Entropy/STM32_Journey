void mhal_gpio_toggle(const char *pin){
	/*
	* ALL IN ONE; TOGGLES THE PIN
	* NO PRIOR PIN CONFIG NEEDED
	*/
	uint8_t port_ref = pin[1] - 'A';
	uint8_t pin_ref = pin[2] - '0';
	GPIO_TypeDef *port = {};

	switch(port_ref){
		case 0:
			port = GPIOA;
			break;
		case 1:
			port = GPIOB;
			break;
		case 2:
			port = GPIOC;
			break;
		case 3:
			port = GPIOD;
			break;
		case 4:
			port = GPIOE;
			break;
		case 5:
			port = GPIOH;
			break;
		}
	port->BSRR = mhal_gpio_read(port, pin_ref) ? 0x01UL<<(pin_ref+16) : 0x01UL<<pin_ref;
}

