void mhal_dma_init(const mhal_dma_config_t *config){
	/*
	 * Configure a dma stream, leave it disabled
	 * -> Disable stream (EN=0)
	 * -> Wait for hardware acknowledgement
	 * -> Clear status flags for stream
	 * -> Write peripheral and memory addresses
	 * -> Write # of items to transfer
	 * -> Configure CR (direction, sizes, priority, mode)
	 * -> Leave EN=0
	 */

	DMA_Stream_TypeDef *stream = config->stream;

	//Disable stream
	stream->CR &= ~DMA_SxCR_EN;

	//Hardware takes few cycles to shutdown after the write
	while (stream->CR & DMA_SxCR_EN){}

	//Clear all flags
	mhal_dma_clear_flags(stream);

	//write peripheral and memory addresses
	stream->PAR = config->periph_addr;
	stream->M0AR = config->mem_addr;

	//write # of items to transfer
	stream->NDTR = config->length;

	//configure CR
	//NOT HERE//stream->CR |= DMA_SxCR_TCIE; //Transfer complete interrupt enable
	stream->CR &= ~DMA_SxCR_PFCTRL; //DMA controls flow, stops when NDTR is 0.

	stream->CR &= ~DMA_SxCR_DIR_Msk;
	stream->CR |= (config->direction)<<DMA_SxCR_DIR_Pos; //Data transfer direction

	stream->CR &= ~DMA_SxCR_CIRC_Msk;
	stream->CR |= (config->circular)<<DMA_SxCR_CIRC_Pos; //Circular buffer?

	stream->CR &= ~DMA_SxCR_PINC_Msk;
	stream->CR |= (config->periph_inc)<<DMA_SxCR_PINC_Pos;//Peripheral increase?

	stream->CR &= ~DMA_SxCR_MINC_Msk;
	stream->CR |= (config->mem_inc)<<DMA_SxCR_MINC_Pos;//Memory increase?

	stream->CR &= ~DMA_SxCR_PSIZE_Msk;
	stream->CR |= (config->periph_size)<<DMA_SxCR_PSIZE_Pos;//Peripheral data size

	stream->CR &= ~DMA_SxCR_MSIZE_Msk;
	stream->CR |= (config->mem_size)<<DMA_SxCR_MSIZE_Pos;//Memory data size

	stream->CR &= ~DMA_SxCR_PL_Msk;
	stream->CR |= (config->priority)<<DMA_SxCR_PL_Pos;//stream priority

	stream->CR &= ~DMA_SxCR_CHSEL_Msk;
	stream->CR |= (config->channel)<<DMA_SxCR_CHSEL_Pos;//Choose channel
}

void mhal_dma_start(DMA_Stream_TypeDef *stream){
	stream->CR |= DMA_SxCR_EN;
}

void mhal_dma_stop(DMA_Stream_TypeDef *stream){
	stream->CR &= ~DMA_SxCR_EN;
	while(stream->CR & DMA_SxCR_EN){}
}

void mhal_dma_enable_irq(DMA_Stream_TypeDef *stream, uint8_t priority){

	//clear any flags before enabling
	mhal_dma_clear_flags(stream);

	stream->CR |= (DMA_SxCR_TCIE | DMA_SxCR_HCIE);
	IRQn_Type irqn = mhal_dma_stream_to_irqn(stream);
	NVIC_SetPriority(irqn, priority);
	NVIC_EnableIRQ(irqn);
}

void mhal_dma_disable_irq(DMA_Stream_TypeDef *stream){
	stream->CR &= ~(DMA_SxCR_TCIE | DMA_SxCR_HCIE);
}

void mhal_dma_clear_flags(DMA_Stream_TypeDef *stream){
	uint32_t idx = mhal_dma_stream_to_index(stream);
	if (idx<4){
		uint32_t mask = 0x3FU<<(idx*6);
		DMA1->LIFCR |= mask;
	}

}

uint32_t mhal_dma_remaining(DMA_Stream_TypeDef *stream){
	return stream->NDTR;
}


