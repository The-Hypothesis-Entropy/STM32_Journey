/*------------------------------------------
 * PWM LEMMA FUNCTIONS
 ------------------------------------------*/
void mhal_tim_pwm_chn_prld_mode_cfg(TIM_TypeDef *tim, mhal_tim_channel_t channel){
	//* Configure channel of tim to be output and enable preload register
	//* Preload register means an update to ccrx is buffered
	//* The new ccrx is enforced on the next timer cycle after uev generated.
	//* Set pwm mode-OCxM as mode 1 (110)

	if(channel < 2U){
		if(channel == MHAL_TIM_CH1){
			tim->CCMR1 &= ~(TIM_CCMR1_CC1S | TIM_CCMR1_OC1M_Msk); //chn1 set as output, clear pwm mode field
			tim->CCMR1 |= (TIM_CCMR1_OC1PE | 0x6UL<<4U); //chn1 preload register enabled, pwm mode 1 set
		}
		else{
			tim->CCMR1 &= ~(TIM_CCMR1_CC2S | TIM_CCMR1_OC2M_Msk); //chn2 set as output, clear pwm mode field
			tim->CCMR1 |= (TIM_CCMR1_OC2PE | 0x6UL<<12U); //chn2 preload register enabled, pwm mode 1 set
		}
	}
	else{
		if(channel == MHAL_TIM_CH3){
			tim->CCMR2 &= ~(TIM_CCMR2_CC3S | TIM_CCMR2_OC3M_Msk); //chn3 set as output, clear pwm mode field
			tim->CCMR2 |= (TIM_CCMR2_OC3PE | 0x6UL<<4U); //chn3 preload register enabled, pwm mode 1 set
		}
		else{
			tim->CCMR2 &= ~(TIM_CCMR2_CC4S | TIM_CCMR2_OC4M_Msk); //chn4 set as output, clear pwm mode field
			tim->CCMR2 |= (TIM_CCMR2_OC4PE | 0x6UL<<12U); //chn4 preload register enabled, pwm mode 1 set

		}
	}


}

void mhal_tim_pwm_set_duty(TIM_TypeDef *tim, mhal_tim_channel_t channel, uint16_t duty){
//resolution can be improved here!
	if (duty>128)duty = 128;
	if (duty<0)duty = 0;

	duty = (duty*((tim->ARR) + 1))>>7U;
	switch(channel){
	case MHAL_TIM_CH1:
		tim->CCR1 = duty;
		break;
	case MHAL_TIM_CH2:
		tim->CCR2 = duty;
		break;
	case MHAL_TIM_CH3:
		tim->CCR3 = duty;
		break;
	case MHAL_TIM_CH4:
		tim->CCR4 = duty;
		break;
	}
}

void mhal_tim_pwm_channel_output_enable(TIM_TypeDef *tim, mhal_tim_channel_t channel){
	// To make signal output on the corresponding output pin
	switch(channel){
		case MHAL_TIM_CH1:
			tim->CCER |= TIM_CCER_CC1E;
			break;
		case MHAL_TIM_CH2:
			tim->CCER |= TIM_CCER_CC2E;
			break;
		case MHAL_TIM_CH3:
			tim->CCER |= TIM_CCER_CC3E;
			break;
		case MHAL_TIM_CH4:
			tim->CCER |= TIM_CCER_CC4E;
			break;
		}









}

