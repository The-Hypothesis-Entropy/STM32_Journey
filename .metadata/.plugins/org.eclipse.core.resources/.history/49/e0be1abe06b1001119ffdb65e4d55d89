void mhal_tim_pwm_init(TIM_TypeDef *tim, const mhal_tim_pwm_config_t *config){
	/*
	 * Configure timer, channel, duty. Doesn't start counting
	 */
	//Enable the timer's clock
	mhal_tim_enable_clock(tim);

	//Read timer's input clock frequency
	uint32_t tim_clk = mhal_tim_get_clock(tim);

	//Stop the timer
	tim->CR1 &= ~TIM_CR1_CEN;

	//Calculate and assign arr, psc
	mhal_tim_arr_psc_resolution(tim, tim_clk, config->frequency_hz);

	//Configure channel as output-CCxS, and enable preload-OCxPE (to avoid glitches)
	mhal_tim_pwm_chn_prld_mode_cfg(tim, config->channel);

	//write duty cycle-CCRx
	mhal_tim_pwm_set_duty(tim, config->channel, config->duty);

	//Enable channel output-CCER.CCxE
	mhal_tim_pwm_channel_output_enable(tim, config->channel);

	if(tim==TIM1){//for TIM1, enable main output
		tim->BDTR |= TIM_BDTR_MOE;
	}

	//Set ARPE to ensure arr is buffered as well. no glitches.
}

