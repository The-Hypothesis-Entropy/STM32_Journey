void mhal_tim_base_init(TIM_TypeDef *tim, const mhal_tim_base_config_t *config){
	//Enable timer peripheral's clock
	mhal_tim_enable_clock(tim);

	//Read timer's input clock frequency (pure, before PSC applied)
	uint32_t tim_clk = mhal_tim_get_clock(tim);

	//Stop the timer. if it is already running, writing PSC or ARR (next step) can cause undefined behavior
	tim->CR1 &= ~(TIM_CR1_CEN_Msk);

	//Solve for/assign PSC and ARR (try to make ARR as large as possible, and PSC as small as possible)
	mhal_tim_arr_psc_resolution(tim, tim_clk, config->frequency_hz);

}

void mhal_tim_base_init_basic(TIM_TypeDef *tim, mhal_tim_base_cfg_t *config){
	//Stop timer if running.
	tim->CR1 &= ~TIM_CR1_CEN;
	//Enable timer peripheral's clock
		if(tim==TIM1){RCC->APB2ENR |= RCC_APB2ENR_TIM1EN;}

	#ifdef TIM9
		else if(tim==TIM9){RCC->APB2ENR |= RCC_APB2ENR_TIM9EN;}
	#endif
	#ifdef TIM10
		else if(tim==TIM10){RCC->APB2ENR |= RCC_APB2ENR_TIM10EN;}
	#endif
	#ifdef TIM11
		else if(tim==TIM11){RCC->APB2ENR |= RCC_APB2ENR_TIM11EN;}
	#endif
	#ifdef TIM2
		else if(tim==TIM2){RCC->APB1ENR |= RCC_APB1ENR_TIM2EN;}
	#endif
	#ifdef TIM3
		else if(tim==TIM3){RCC->APB1ENR |= RCC_APB1ENR_TIM3EN;}
	#endif
	#ifdef TIM4
		else if(tim==TIM4){RCC->APB1ENR |= RCC_APB1ENR_TIM4EN;}
	#endif
	#ifdef TIM5
		else if(tim==TIM5){RCC->APB1ENR |= RCC_APB1ENR_TIM5EN;}
	#endif

	tim->ARR = config->arr;
	tim->PSC = config->psc;
	tim->EGR = TIM_EGR_UG;
	tim->SR &= ~TIM_SR_UIF;

	tim->CR1 &= ~TIM_CR1_DIR_Msk;
	tim->CR1 |= ((uint16_t)(config->dir))<<TIM_CR1_DIR_Pos;
}

void mhal_tim_base_start(TIM_TypeDef *tim){ //start or continue. hasnt wiped CNT
	tim->CR1 |= TIM_CR1_CEN;
}

void mhal_tim_base_stop(TIM_TypeDef *tim){
	tim->CR1 &= ~TIM_CR1_CEN;
}

void mhal_tim_enable_update_irq(TIM_TypeDef *tim, uint8_t priority){
	/*
	 * THREE GATES FOR THE INTERRUPT PATH
	 * 1. UDIS (CR1): Do update events get generated?
	 * 2. UIE (DIER): Does a generated update event send request to NVIC?
	 * 3. NVIC: should cpu ccare about this? and how urgently?
	 */
	tim->CR1 &= ~TIM_CR1_UDIS; //UEV will be generated, thus UIF will be set
	tim->SR &= ~TIM_SR_UIF; //incase flag had been set (for UEVs) prior to uie on
	tim->DIER |= TIM_DIER_UIE;
	IRQn_Type num=100; //just a random number as a guard
	if(tim==TIM1)num=TIM1_UP_TIM10_IRQn; //for TIM1 update
#ifdef TIM9
	else if(tim==TIM9)num=TIM1_BRK_TIM9_IRQn; //for TIM9 global interrupt
#endif
#ifdef TIM10
	else if(tim==TIM10)num=TIM1_UP_TIM10_IRQn; //for TIM10 global interrupt
#endif
#ifdef TIM2
	else if(tim==TIM2)num=TIM2_IRQn;
#endif
#ifdef TIM3
	else if(tim==TIM3)num=TIM3_IRQn;
#endif
#ifdef TIM4
	else if(tim==TIM4)num=TIM4_IRQn;
#endif
#ifdef TIM5
	else if(tim==TIM5)num=TIM5_IRQn;
#endif
#ifdef TIM11
	else if(tim==TIM11)num=TIM1_TRG_COM_TIM11_IRQn; //TIM11 global shared
#endif
	if(num!=100){
	if(priority>15U)priority=15U;
	NVIC_SetPriority(num, priority);
	NVIC_EnableIRQ(num);
	}
}

void mhal_tim_disable_update_irq(TIM_TypeDef *tim){
	tim->DIER &= ~TIM_DIER_UIE; //no interrupt request per UEV
}

void mhal_tim_clear_update_flag(TIM_TypeDef *tim){
	tim->SR &= ~TIM_SR_UIF;
}

uint32_t mhal_tim_get_counter(TIM_TypeDef *tim){
	return tim->CNT;
}

void mhal_tim_base_on(TIM_TypeDef *tim, uint32_t freq, uint8_t priority){
	/*
	 * ALL-IN-ONE: TIMER IS INITIALIZED AND STARTED TO UEV AT FREQ
	 * All you need to do is write the handler
	 */
	const mhal_tim_base_config_t cfg = {.frequency_hz = freq};
	mhal_tim_base_init(tim, &cfg);
	mhal_tim_enable_update_irq(tim, priority);
	mhal_tim_base_start(tim);
}

