 ------------------------------------------*/
void mhal_tim_enable_clock(TIM_TypeDef *tim){
	//Enable timer peripheral's clock
		if(tim==TIM1){RCC->APB2ENR |= RCC_APB2ENR_TIM1EN;}

	#ifdef TIM9
		else if(tim==TIM9){RCC->APB2ENR |= RCC_APB2ENR_TIM9EN;}
	#endif
	#ifdef TIM10
		else if(tim==TIM10){RCC->APB2ENR |= RCC_APB2ENR_TIM10EN;}
	#endif
	#ifdef TIM11
		else if(tim==TIM11){RCC->APB2ENR |= RCC_APB2ENR_TIM11EN;}
	#endif
	#ifdef TIM2
		else if(tim==TIM2){RCC->APB1ENR |= RCC_APB1ENR_TIM2EN;}
	#endif
	#ifdef TIM3
		else if(tim==TIM3){RCC->APB1ENR |= RCC_APB1ENR_TIM3EN;}
	#endif
	#ifdef TIM4
		else if(tim==TIM4){RCC->APB1ENR |= RCC_APB1ENR_TIM4EN;}
	#endif
	#ifdef TIM5
		else if(tim==TIM5){RCC->APB1ENR |= RCC_APB1ENR_TIM5EN;}
	#endif
}

static uint32_t mhal_tim_get_clock(TIM_TypeDef *tim){
	//Read system clock frequency
	uint32_t hclk = SystemCoreClock;

	//Identify APB bus on which the timer is
	//on f401re;
	//	APB2: TIM1, TIM9, TIM10, TIM11
	//  APB1: TIM2, TIM3, TIM4, TIM5
	uint32_t ppre_field = 0U;
	if((tim==TIM1)
#ifdef TIM9
			||(tim==TIM9)
#endif
#ifdef TIM10
			||(tim==TIM10)
#endif
#ifdef TIM11
			||(tim==TIM11)
#endif
			)
		{ppre_field = ((RCC->CFGR)>>13U) & 7U;}
	else if((tim==TIM2)||(tim==TIM3)||(tim==TIM4)||(tim==TIM5)){
		ppre_field = ((RCC->CFGR)>>10) & 7U;
	}

	//Decode 3-bit prescaler field into actual divide factor
	uint32_t psc;
	switch(ppre_field){
	case 4:
		psc = 2U;
		break;
	case 5:
		psc = 4U;
		break;
	case 6:
		psc = 8U;
		break;
	case 7:
		psc = 16U;
		break;
	default:
		psc = 1U;
		break;
	}

	//Compute the bus frequency
	uint32_t tim_clk = hclk / psc;

	//ST quirk
	if(psc == 1U)return tim_clk;
	else return tim_clk*2U;

}

void mhal_tim_arr_psc_resolution(TIM_TypeDef *tim, uint32_t tim_clk, uint32_t freq){
	/*
	 * SOLVES FOR THE ARR AND PSC TO FULFIL FREQUENCY REQUIREMENTS
	 * SETS THE ARR AND PSC REGISTERS WITH THE CORRESPONDING VALUES AS WELL
	 */
	uint32_t max_arr = ((tim==TIM2)||(tim==TIM5)) ? 0xFFFFFFFF : 0xFFFF;

	uint32_t divisor = tim_clk / freq;// config->frequency_hz;
	if (divisor==0U)divisor=1U; //incase requested frequency is too high

	uint32_t psc, arr;
	if(divisor<=max_arr+1){
		psc = 0U;
		arr = divisor - 1U;
	}
	else{ //ceil(a/b) = (a+b-1)/b
		psc = (divisor+max_arr) / (max_arr + 1U);
		psc--;
		if(psc>0xFFFFU)psc=0xFFFFU; //caps at 16bit max
		arr = divisor / (psc + 1);
		arr--;
		if(arr>(max_arr)){
			arr = max_arr;
		}
	}
	//Load PSC and ARR into corresponding registers
	tim->ARR = arr;
	tim->PSC = psc;

	//Force update (arr and psc are buffered)
	tim->EGR = TIM_EGR_UG; //safe because EGR is a trigger register

	//Clear UIF set by previous step
	tim->SR &= ~(TIM_SR_UIF_Msk);
}

