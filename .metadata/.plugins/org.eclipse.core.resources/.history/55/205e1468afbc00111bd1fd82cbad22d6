#include "mhal_i2c.h"
#include "stm32f401xe.h"

#define MHAL_I2C_TIMEOUT 100000U

/*---------------LEMMA FUNCTIONS---------------*/
static void mhal_i2c_clk(I2C_TypeDef *i2c){
#ifdef I2C1
	if(i2c==I2C1)RCC->APB1ENR|=RCC_APB1ENR_I2C1EN;
#endif
#ifdef I2C2
	if(i2c==I2C2)RCC->APB1ENR|=RCC_APB1ENR_I2C2EN;
#endif
#ifdef I2C3
	if(i2c==I2C3)RCC->APB1ENR|=RCC_APB1ENR_I2C3EN;
#endif
}

static uint8_t mhal_i2c_wait_flag(I2C_TypeDef *i2c, uint32_t mask){
	uint32_t timeout = MHAL_I2C_TIMEOUT;
	while(!(i2c->SR1 & mask)){
		if(--timeout==0) return MHAL_I2C_ERR_TIMEOUT;
	}
	return MHAL_I2C_OK;
}

static uint8_t mhal_i2c_start(I2C_TypeDef *i2c){
	i2c->CR1 |= I2C_CR1_START; //generate start bit
	return mhal_i2c_wait_flag(i2c, I2C_SR1_SB);
}

static void mhal_i2c_stop(I2C_TypeDef *i2c){
	i2c->CR1 &= ~I2C_CR1_STOP;
}

static uint8_t mhal_i2c_send_addr(I2C_TypeDef *i2c, uint8_t dev_addr, uint8_t rw){
	i2c->DR = (uint8_t)((dev_addr << 1) | (rw & 0x01U));

	//wait for addr or af
	uint32_t timeout = MHAL_I2C_TIMEOUT;
	while(1){
		uint32_t sr1 = i2c->SR1;
		if(sr1 & I2C_SR1_ADDR)break;
		if(sr1 & I2C_SR1_AF){
			i2c->SR1 &= ~I2C_SR1_AF;
			mhal_i2c_stop(i2c);
			return MHAL_I2C_ERR_NACK;
		}
		if(--timeout==0U){
			mhal_i2c_stop(i2c);
			return MHAL_I2C_ERR_TIMEOUT;
		}
	}

	//Clear ADDR by reading SR1 then SR2 (required by hardware)
	(void)i2c->SR1;
	(void)i2c->SR2;
	return MHAL_I2C_OK;
}

static uint8_t mhal_i2c_write_byte(I2C_TypeDef *i2c, uint8_t b){
	uint8_t r = mhal_i2c_wait_flag(i2c, I2C_SR1_TXE);
	if(r!=MHAL_I2C_OK)return r;

	i2c->DR = b;

	//Check for NACK after the byte
	if(i2c->SR1 & I2C_SR1_AF){
		i2c->SR1 &= ~I2C_SR1_AF;
		mhal_i2c_stop(i2c);
		return MHAL_I2C_ERR_NACK;
	}
	return MHAL_I2C_OK;
}

static uint8_t mhal_i2c_read_byte(I2C_TypeDef *i2c, uint8_t ack, uint8_t *out){
	if(ack){
		i2c->CR1 |= I2C_CR1_ACK;
	}
	else{
		i2c->CR1 &= ~I2C_CR1_ACK;
	}

	uint8_t r = mhal_i2c_wait_flag(i2c, I2C_SR1_RXNE);
	if(r!=MHAL_I2C_OK)return r;

	*out = (uint8_t)i2c->DR;
	return MHAL_I2C_OK;
}

static void mhal_i2c_gpio_config(I2C_TypeDef *i2c){
	mhal_gpio_config_t config = MHAL_GPIO_CFG_AF;
	config.type = MHAL_GPIO_OT_OD;
	config.af = 4U;
	//uint8_t sda_af =

#ifdef I2C1
	if(i2c==I2C1){
		mhal_gpio_init(GPIOB, 8, config); //SCL
		mhal_gpio_init(GPIOB, 9, config); //SDA
	}
#endif
#ifdef I2C2
	if(i2c==I2C2){
		mhal_gpio_init(GPIOB, 10, config); //SCL
		mhal_gpio_init(GPIOB, 1, config); //SDA
	}
#endif
}

/*-------------------PUBLIC API-------------------*/

void mhal_i2c_init(I2C_TypeDef *i2c, const mhal_i2c_config_t *config){
	mhal_i2c_clk(i2c);
	uint32_t pclk = mhal_rcc_get_periph_freq(MHAL_I2C1_PERIPHERAL);

	//Software reset
	i2c->CR1 |= I2C_CR1_SWRST;
	i2c->CR1 &= ~I2C_CR1_SWRST;

	//Derive APB1 Clock. They are all on APB1
	uint32_t mhz = pclk / 1000000U; //Any i2c would do, all on thesame bus

	//Freq field must be set before pe and ccr/trise
	i2c->CR2 &= ~I2C_CR2_FREQ;
	mhz = (mhz>=50) ? 50 : ((mhz<=2) ? 2 : mhz); //reference manual gives bounds on mhz
	i2c->CR2 |= mhz;

	if (config->speed == MHAL_I2C_SPEED_FAST){
		i2c->CCR = I2C_CCR_FS | (pclk / (3U * 400000U));
		i2c->TRISE = ((mhz * 300U) / 1000U) + 1U;
	}
	else {
		i2c->CCR = pclk / (2U * 100000U);
		i2c->TRISE = mhz + 1U;
	}

	i2c->CR1 |= I2C_CR1_PE;

}

uint8_t mhal_i2c_write(I2C_TypeDef *i2c, uint8_t dev, const uint8_t *data, uint32_t len){
	uint8_t r = mhal_i2c_start(i2c); if(r)return r;
	r = mhal_i2c_send_addr(i2c, dev, 0); if(r)return r;

	for (uint32_t i=0; i<len; i++){
		r = mhal_i2c_wait_flag(i2c, I2C_SR1_TXE); if(r) return r;
		i2c->DR = data[i];

		if (i2c->SR1 & I2C_SR1_AF){ //NO ACKNOWLEDGE FAILURE
			i2c->SR1 &= ~I2C_SR1_AF;
			i2c->CR1 |= I2C_CR1_STOP;
			return MHAL_I2C_ERR_NACK;
		}
	}

	//wait for last byte to leave shift register
	r = mhal_i2c_wait_flag(i2c, I2C_SR1_BTF); if(r) return r;
	i2c->CR1 |= I2C_CR1_STOP;
	return MHAL_I2C_OK;
}

uint8_t mhal_i2c_read(I2C_TypeDef *i2c, uint8_t dev, uint8_t *data, uint32_t len){
	if(len==0U)return MHAL_I2C_OK;

	//Preconfig ack/pos for n=1/2. (must be done before clearing addr)
	if(len==1U){
		i2c->CR1 &= ~I2C_CR1_ACK;
		i2c->CR1 |= I2C_CR1_POS;
	}
	else{
		i2c->CR1 |= I2C_CR1_ACK;
		i2c->CR1 &= ~I2C_CR1_POS;
	}

	uint8_t r = mhal_i2c_start(i2c); if(r) return r;
	r = mhal_i2c_send_addr(i2c, dev, 1);
	if(r){i2c->CR1 &= ~I2C_CR1_POS; return r;}

	if(len==1U){
		//stop now, then read the single byte as it arrives
		i2c->CR1 |= I2C_CR1_STOP;
		i2c->CR1 &= ~I2C_CR1_POS;
		r = mhal_i2c_wait_flag(i2c, I2C_SR1_RXNE); if(r) return r;
		data[0] = (uint8_t)i2c->DR;
		return MHAL_I2C_OK;
	}

	if(len==2U){
		//wait for both bytes to be received then STOP and read
		i2c->CR1 |= I2C_CR1_POS;
		i2c->CR1 &= ~I2C_CR1_ACK;
		r = mhal_i2c_wait_flag(i2c, I2C_SR1_BTF);
		if(r){i2c->CR1 &= ~I2C_CR1_POS; return r;}
		i2c->CR1 |= I2C_CR1_STOP;
		i2c->CR1 &= ~I2C_CR1_POS;
		data[0] = (uint8_t)i2c->DR;
		data[1] = (uint8_t)i2c->DR;
		return MHAL_I2C_OK;
	}

	//For n>=3, ack all but the last three, then use btf sequence
	for (uint32_t i=0; i<len-3U; i++){
		r = mhal_i2c_wait_flag(i2c, I2C_SR1_RXNE); if(r) return r;
		data[i] = (uint8_t)i2c->DR;
	}

	r = mhal_i2c_wait_flag(i2c, I2C_SR1_BTF); if (r) return r;
	i2c->CR1 &= ~I2C_CR1_ACK;
	data[len-3U] = (uint8_t)i2c->DR;

	r = mhal_i2c_wait_flag(i2c, I2C_SR1_BTF); if(r) return r;
	i2c->CR1 |= I2C_CR1_STOP;
	data[len-2U] = (uint8_t)i2c->DR;
	data[len-1U] = (uint8_t)i2c->DR;
	return MHAL_I2C_OK;
}

uint8_t mhal_i2c_write_reg(I2C_TypeDef *i2c, uint8_t dev, uint8_t reg, const uint8_t *data, uint32_t len){
	uint8_t r = mhal_i2c_start(i2c); if(r)return r;
	r = mhal_i2c_send_addr(i2c, dev, 0); if (r) return r;

	r = mhal_i2c_wait_flag(i2c, I2C_SR1_TXE); if (r) return r;
	i2c->DR = reg;

	for (uint32_t i=0; i<len; i++){
		r = mhal_i2c_wait_flag(i2c, I2C_SR1_TXE); if (r) return r;
		i2c->DR = data[i];
	}

	r = mhal_i2c_wait_flag(i2c, I2C_SR1_BTF); if (r) return r;
	i2c->CR1 |= I2C_CR1_STOP;
	return MHAL_I2C_OK;
}

uint8_t mhal_i2c_read_reg(I2C_TypeDef *i2c, uint8_t dev, uint8_t reg, uint8_t *data, uint32_t len){
	//Phase 1: write register address. no STOP - the next START
	uint8_t r = mhal_i2c_start(i2c); if(r) return r;
	r = mhal_i2c_send_addr(i2c, dev, 0); if(r) return r;
	r = mhal_i2c_wait_flag(i2c, I2C_SR1_TXE); if(r) return r;
	i2c->DR = reg;
	r = mhal_i2c_wait_flag(i2c, I2C_SR1_BTF); if(r) return r;

	//Phase 2: repeated START + read
	return mhal_i2c_read(i2c, dev, data, len);
}


