#include "etonde.h"
/*
 *                    ETONDE: THE LINK THAT BRINGS THINGS TOGETHER
 *
 * 								       FRAME
 * 			    [START1][START2][DST][SRC][TYPE][LEN][...PAYLOAD...][CRC]
 *
 * Usage example
 * -> uint16_t frame_length = ET_buildFrame(ET_STM32_NF401RE, ET_ESP32C3, ET_RESPONSE, 30, data, msg); //data is payload (of length 30's) pointer, msg is frame pointer
 * -> ET_Status_t sign = ET_parseFrame(mhal_uart_rx_byte, &frame); //sign will only be ET_SUCCESS after crc passed and entire frame is valid. DO THIS FOR EVERY RECEIVED BYTE
 * -> Access valid frame: if(sign==ET_SUCCESS){
							mhal_uart_write(USART2, frame.payload, frame.length);
							sign = ET_RECV_BUSY;}
 */

//-----------------------------BUILDER------------------------
static uint16_t ET_calcCRC16(const uint8_t *d, uint16_t n){
	uint16_t c = 0xFFFF;
	while(n--){
		c ^= ((uint16_t)*d++) << 8 ;
		for(uint8_t i = 0; i<8; i++){
			c = (c & 0x8000) ? (c<<1)^0x1021 : (c<<1U);
		}
	}
	return c;
}

uint16_t ET_buildPacket(uint8_t dst, uint8_t src, uint8_t type, uint8_t len, uint8_t *payload, uint8_t *packet){
	/*
	 * dst: destination address
	 * src: source address (of this device)
	 * type: code denoting the nature/intent of this frame
	 * len: length of the payload
	 * payload: data to be sent
	 * crc: CRC value (two bytes)
	 * returns the number of bytes in the frame
	 */
	uint16_t index = 0;

	//START BYTES
	packet[index++] = START1;
	packet[index++] = START2;

	//DESTINATION BYTE
	packet[index++] = dst;

	//SOURCE BYTE
	packet[index++] = src;

	//TYPE BYTE
	packet[index++] = type;

	//LENGTH BYTE
	packet[index++] = len;

	//PAYLOAD BYTES
	for(uint16_t i=0; i<len; i++){
		packet[index++] = payload[i];
	}

	//CRC BYTE //little endian
	uint16_t crc = ET_calcCRC16(packet+2U, len+4U);
	packet[index++] = (uint8_t)(crc & 0xFF);
	packet[index++] = (uint8_t)(crc >> 8U);

	return index++; //overall number of bytes in frame
}

