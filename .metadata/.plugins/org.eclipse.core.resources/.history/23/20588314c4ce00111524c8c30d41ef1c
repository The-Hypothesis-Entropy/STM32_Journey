//----------------------------DISPATCHER------------------------

/*
 *
 */

void ET_dispatchResetTable(void){
	for(uint16_t i=0; i<256; i++){
		ET_dispatchTable[i] = NULL;
	}
}

uint16_t ET_dispatch_Handler(const ET_Frame_t *frame){
	if (frame == NULL){
		return ET_ERROR_NOFRAME;
	}
	ET_Handler h = ET_dispatchTable[frame->type];
	if (h==NULL){
		return ET_ERROR_NOHANDLERFORTYPE;
	}
	return h(frame);
}

ET_Status_t ET_dispatch_regHandler(uint8_t type, ET_Handler h){
	if(h == NULL){
		return ET_ERROR_NOHANDLE;
	}
	if(ET_dispatchTable[type] != NULL){
		return ET_ERROR_ATTEMPTEDHANDLEOVERRIDE;
	}
	ET_dispatchTable[type] = h;
	return ET_SUCCESS;
}


/*
 * HANDLERS: ALL HAVE SAME SIGNATURE
 * THE RETURNED VALUE IS THE SIZE OF THE ENTIRE RESPONSE PACKET. USE THIS WHEN SENDING THE PACKET
 * IF THERE IS NO RESPONSE PACKET, RETURN 0
 *
 * To use the dispatcher; Write the static handle for your frametype, call the init (add to table)
 * Then you can use the ET_dispatch_Handler for any received frame
 */

uint8_t ET_responsePacket[270];
//***********-----------SYSTEM
static uint16_t ET_handle_PING(const ET_Frame_t *frame){
	//PING RECEIVED, RESPOND WITH PONG
	return ET_buildPacket(frame->src, ET_SELF, ET_TypePONG, 0, (uint8_t *)0, ET_responsePacket);
}

//***********-----------MEMORY ACCESS
static uint16_t ET_handle_MEM_WRITE(const ET_Frame_t *frame){
	uint32_t address = ((frame->payload)[0]<<24)|((frame->payload)[1]<<16)|((frame->payload)[2]<<8)|((frame->payload[3]));
	uint8_t data = frame->payload[4];
	*(uint8_t *)address = data;
	return 0;
}

static uint16_t ET_handle_MEM_READ(const ET_Frame_t *frame){
	uint32_t address = ((frame->payload)[0]<<24)|((frame->payload)[1]<<16)|((frame->payload)[2]<<8)|((frame->payload[3]));
	uint8_t data = *(uint8_t *)address;
	return ET_buildPacket(frame->src, ET_SELF, ET_TypeMEM_READ_RES, 1, &data, ET_responsePacket);
}

//***********-----------PERIPHERAL CONFIG

static uint16_t ET_handle_GPIO_CFG(const ET_Frame_t *frame){
	/*
	 *	PAYLOAD: [PORT LETTER][PIN NUMBER][MODE][OTYPE][OSPEED][PUPD][AF]
	 */
	uint8_t gpio_config[] = {(frame->payload)[0], (frame->payload)[1], (frame->payload)[2], (frame->payload)[3], (frame->payload)[4], (frame->payload)[5], (frame->payload)[6]};
	ET_GPIO_config(gpio_config);
	return 0;
}

void ET_dispatchInit(void){
	ET_dispatchResetTable();
	ET_dispatch_regHandler(ET_TypePING, ET_handle_PING);
	ET_dispatch_regHandler(ET_TypeMEM_WRITE, ET_handle_MEM_WRITE);
	ET_dispatch_regHandler(ET_TypeMEM_READ, ET_handle_MEM_READ);


	ET_dispatch_regHandler(ET_TypeGPIO_CFG, ET_handle_GPIO_CFG);

}











