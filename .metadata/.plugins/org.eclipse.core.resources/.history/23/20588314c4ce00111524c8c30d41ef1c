//---------------------------PARSER-----------------------------
ET_State_t state = ET_WAIT_START1;
volatile uint8_t crc1, crc2;
volatile uint8_t payloadCounter = 0;
volatile uint8_t hold_crc1 = 0U;
static void ET_clearFrame(ET_Frame_t *frame){
	uint16_t i = frame->length + 6U;
	for(uint16_t x=0; x<i; x++){
		*(&(frame->dst)+x) = 0U;
	}
}

ET_Status_t ET_parseFrame(uint8_t byte, ET_Frame_t *frame){
	/*
	 * byte: most recently received byte
	 * frame: pointer to a ET_Frame_t object the user created; this will store the parsed frame
	 * 		  Parsed frame contains dst, src, type, length and payload
	 * returns either ET_SUCCESS when a frame is completely parsed, or ET_RECV_BUSY when not so.
	 *
	 * Usage: for every received byte, call this function, pass the byte and the frame memory to hold the data
	 * Check for when the function returns ET_SUCCESS. That is when the *frame data is reliable
	 */
	switch(state){
		case ET_WAIT_START1:
			if(byte==START1){state=ET_WAIT_START2;}
			break;
		case ET_WAIT_START2:
			if(byte==START1){return ET_RECV_BUSY;}
			else{
				if(byte==START2){state=ET_WAIT_DST;}
				else{state=ET_WAIT_START1;}
			}
			break;
		case ET_WAIT_DST:
			if(byte==ET_SELF){frame->dst = byte; state=ET_WAIT_SRC;}
			else{state=ET_WAIT_START1;}
			break;
		case ET_WAIT_SRC:
			frame->src = byte;
			state=ET_WAIT_TYPE;
			break;
		case ET_WAIT_TYPE:
			frame->type = byte;
			state=ET_WAIT_LEN;
			break;
		case ET_WAIT_LEN:
			frame->length = byte;
			state=ET_WAIT_PAYLOAD;
			payloadCounter = 0U;
			if(byte==0U){state=ET_WAIT_CRC1;}
			if((frame->length == 0U) && (frame->src == ET_DEBUG)){state=ET_WAIT_START1; return ET_SUCCESS;}
			break;
		case ET_WAIT_PAYLOAD:
			frame->payload[payloadCounter++] = byte;
			if(frame->length==payloadCounter){ //length==counter?
				state=ET_WAIT_CRC1;
				if(frame->src == ET_DEBUG){state=ET_WAIT_START1; return ET_SUCCESS;}
			}
			break;
		case ET_WAIT_CRC1:
			hold_crc1 = (uint8_t)byte;
			state=ET_WAIT_CRC2;
			break;
		case ET_WAIT_CRC2:
			state=ET_WAIT_START1;
			uint16_t crc = ET_calcCRC16(&(frame->dst), frame->length+4U);
			crc1 = (uint8_t)(crc & 0xFF);
			crc2 = (uint8_t)(crc >> 8U);
			if((byte==crc2) && (crc1==hold_crc1)){return ET_SUCCESS;}
			ET_clearFrame(frame);
			return ET_ERROR_CRC;
			break;
	}
	return ET_RECV_BUSY;
}

ET_Device_t ET_readSource(ET_Frame_t *frame){
	return frame->src;
}

ET_Type_t ET_readType(ET_Frame_t *frame){
	return frame->type;
}

uint8_t ET_readLength(ET_Frame_t *frame){
	return frame->length;
}

uint8_t *ET_readPayload(ET_Frame_t *frame){
	return frame->payload;
}

