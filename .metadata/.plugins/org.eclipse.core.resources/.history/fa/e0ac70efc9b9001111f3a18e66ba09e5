/*----------------------------TRAFFIC LIGHT STATES------------------------------*/
typedef enum {
	ST_RED,
	ST_RED_YELLOW,
	ST_GREEN,
	ST_YELLOW,
	ST_PEDESTRIAN
}traffic_state_t;

/*----------------------------TIMING CONSTANTS------------------------------*/
#define T_RED 2000U
#define T_RED_YELLOW 500U
#define T_GREEN 3000U
#define T_YELLOW 1000U
#define T_PED 5000U

/*-----------------------------TRAFFIC LIGHT STATE--------------------------*/
static traffic_state_t tf_state = ST_RED;
static uint32_t tf_state_ms = 0;
static uint8_t ped_req = 0;

/*----------------------------BUTTON DEBOUNCING------------------------------*/
typedef enum {
	BTN_RELEASED = 0,
	BTN_DEBOUNCE_PRESS,
	BTN_PRESSED,
	BTN_DEBOUNCE_RELEASE
}btn_state_t;

static btn_state_t btn_state = BTN_RELEASED;
static uint16_t btn_counter = 0;
#define BTN_DEBOUNCE_SAMPLES 20U

/*----------------------------OUTPUT HELPERS------------------------------*/
static void tf_set_outputs(traffic_state_t s){
	//RED is on in RED, RED_YELLOW and PEDESTRIAN phases
	HAL_GPIO_WritePin(LED_RED_GPIO_Port, LED_RED_Pin, (s==ST_RED || s==ST_RED_YELLOW || s==ST_PEDESTRIAN) ? GPIO_PIN_SET : GPIO_PIN_RESET);

	//Yellow is on in RED_YELLOW and YELLOW phases
	HAL_GPIO_WritePin(LED_YELLOW_GPIO_Port, LED_YELLOW_Pin, (s==ST_YELLOW || s==ST_RED_YELLOW) ? GPIO_PIN_SET : GPIO_PIN_RESET);

	//Green only on in GREEN phase
	HAL_GPIO_WritePin(LED_GREEN_GPIO_Port, LED_GREEN_Pin, s==ST_GREEN ? GPIO_PIN_SET : GPIO_PIN_RESET);

	//Pedestian LED on only in PEDESTRIAN phase
	HAL_GPIO_WritePin(LED_PED_GPIO_Port, LED_PED_Pin, s==ST_PEDESTRIAN ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

static void tf_enter(traffic_state_t next, uint32_t now){
	tf_state = next;
	tf_state_ms = now;
	tf_set_outputs(next);
}

/*----------------------------TRAFFIC LIGHT FSM------------------------------*/

static void traffic_tick(uint32_t now){
	uint32_t elapsed = now - traffic_state_ms;

	switch(traffic_state){
	case ST_RED:
		if(elapsed>=T_RED){
			traffic_enter(ST_RED_YELLOW, now);
		}
		break;

	case ST_RED_YELLOW:
		if(elapsed>=T_RED_YELLOW){
			traffic_enter(ST_GREEN, now);
		}
		break;

	case ST_GREEN:
		if(elapsed>=T_GREEN){
			traffic_enter(ST_YELLOW, now);
		}
		break;

	case ST_YELLOW:
		if(elapsed>=ST_YELLOW){
			if(ped_req){
				ped_req = 0;
				traffic_enter(ST_PEDESTRIAN, now);
			}
			else{
				traffic_enter(ST_RED, now);
			}
		}
		break;

	case ST_PEDESTRIAN:
		if(elapsed>=T_PED){
			traffic_enter(ST_RED, now);
		}
		break;
	}
}

/*----------------------------BUTTON DEBOUNCER FSM------------------------------*/

static void button_tick(void){
	//Remember, onboard button active low. 0 when pressed, 1 when released
	uint8_t raw_pressed = (HAL_GPIO_ReadPin(BTN_GPIO_Port, BTN_Pin)==GPIO_PIN_RESET) ? 1U : 0U;

	switch(btn_state){
	case BTN_RELEASED:
		if(raw_pressed){
			btn_state = BTN_DEBOUNCE_PRESS;
			btn_counter = 0;
		}
		break;

	case BTN_DEBOUNCE_PRESS:
		if(!raw_pressed){
			btn_state = BTN_RELEASED;
		}
		else if (++btn_counter >= BTN_DEBOUNCE_SAMPLES){
			btn_state = BTN_PRESSED;
			ped_req = 1;
		}
		break;

	case BTN_PRESSED:
		if(!raw_pressed){
			btn_state = BTN_DEBOUNCE_RELEASE;
			btn_counter = 0;
		}
		break;

	case BTN_DEBOUNCE_RELEASE:
		if(raw_pressed){
			btn_state = BTN_PRESSED;
		}
		else if (++btn_counter>= BTN_DEBOUNCE_SAMPLES){
			btn_state = BTN_RELEASED;
		}
		break;
	}
}

