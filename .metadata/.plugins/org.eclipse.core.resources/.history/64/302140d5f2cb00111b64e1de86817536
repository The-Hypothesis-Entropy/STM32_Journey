display_device_t display_init(SPI_HandleTypeDef *HSPI, GPIO_TypeDef *cs_port, uint16_t cs_pin, GPIO_TypeDef *res_port, uint16_t res_pin, GPIO_TypeDef *dc_port, uint16_t dc_pin, uint16_t screen_width, uint16_t screen_height){
	/*
	 * SPI MUST BE CONFIGURED ALREADY
	 */
	//Init display struct
	display_device_t display;
	display.hspi = HSPI;
	display.cs_port = cs_port;
	display.res_port = res_port;
	display.dc_port = dc_port;
	display.cs_pin = cs_pin;
	display.res_pin = res_pin;
	display.dc_pin = dc_pin;
	display.width = screen_width;
	display.height = screen_height;

	//GPIO Initialization
	if(cs_port==GPIOA||res_port==GPIOA||dc_port==GPIOA)__HAL_RCC_GPIOA_CLK_ENABLE();
	if(cs_port==GPIOB||res_port==GPIOB||dc_port==GPIOB)__HAL_RCC_GPIOB_CLK_ENABLE();
	if(cs_port==GPIOC||res_port==GPIOC||dc_port==GPIOC)__HAL_RCC_GPIOC_CLK_ENABLE();
	if(cs_port==GPIOD||res_port==GPIOD||dc_port==GPIOD)__HAL_RCC_GPIOD_CLK_ENABLE();

	GPIO_InitTypeDef gpio = {0};
	gpio.Pin = cs_pin;
	gpio.Mode = GPIO_MODE_OUTPUT_PP;
	gpio.Pull = GPIO_NOPULL;
	gpio.Speed = GPIO_SPEED_FREQ_HIGH;
	gpio.Alternate = 0;
	HAL_GPIO_Init(cs_port, &gpio);
	HAL_GPIO_WritePin(cs_port, cs_pin, 1);

	gpio.Pin = res_pin;
	HAL_GPIO_Init(res_port, &gpio);
	gpio.Pin = dc_pin;
	HAL_GPIO_Init(dc_port, &gpio);

	//Run initialization sequence
	hardware_reset(display);
	HAL_GPIO_WritePin(display.cs_port, display.cs_pin, 0);

	writeCmd(display, 0x01); //software reset
	HAL_Delay(150);

	writeCmd(display, 0x11); //sleep out
	HAL_Delay(200);

	writeCmd(display, 0xC0); //Power control 1
	writeData(display, 0xA2); writeData(display, 0x02); writeData(display, 0x84);

	writeCmd(display, 0xC1); //Power control 2
	writeData(display, 0xC5);

	writeCmd(display, 0xC2); //Power control 3
	writeData(display, 0x0A); writeData(display, 0x00);

	writeCmd(display, 0xC3); //Power control 4
	writeData(display, 0x8A); writeData(display, 0x2A);

	writeCmd(display, 0xC4); //Power control 5
	writeData(display, 0x8A); writeData(display, 0x2E);

	writeCmd(display, 0xC5); //Vcom control 1
	writeData(display, 0x0E);

	writeCmd(display, 0x36); //Orientation (MADCTL)
	writeData(display, 0xC8);

	writeCmd(display, 0x3A); //interface pixel format
	writeData(display, 0x05); //16bit/pixel (rgb565)

	writeCmd(display, 0x29);

	HAL_GPIO_WritePin(display.cs_port, display.cs_pin, 1);
	HAL_Delay(100);


	return display;
}

void display_on(display_device_t display){
	writeCmd(display, 0x29);
}

void display_off(display_device_t display){
	writeCmd(display, 0x29);
}

void display_FillRect(display_device_t display, uint8_t x, uint8_t y, uint8_t w, uint8_t h, uint16_t color){
	uint8_t hi = color >> 8;
	uint8_t lo = color & 0xFF;

	HAL_GPIO_WritePin(display.cs_port, display.cs_pin, 0);
	setWindow(display, x, y, x+w-1, y+h-1);
	//HAL_GPIO_WritePin(display.cs_port, display.cs_pin, 1);

	HAL_GPIO_WritePin(display.dc_port, display.dc_pin, 1);

	//HAL_GPIO_WritePin(display.cs_port, display.cs_pin, 0);
	for(uint16_t i=0; i<(w*h); i++){
		HAL_SPI_Transmit(display.hspi, &hi, 1, 100);
		HAL_SPI_Transmit(display.hspi, &lo, 1, 100);
	}
	HAL_GPIO_WritePin(display.cs_port, display.cs_pin, 1);
}

void display_SetBackground(display_device_t display, uint16_t color){
	display_FillRect(display, 0, 0, display.width, display.height, color);
}

void display_orient(display_device_t display, display_orientation_t orient){
	cs_low(display);
	writeCmd(display, 0x36);
	switch(orient){
		case ST7735_ORIENT_0:
			writeData(display, 0xC8);
			break;
		case ST7735_ORIENT_90:
			writeData(display, 0xA8);
			break;
		case ST7735_ORIENT_180:
			writeData(display, 0x08);
			break;
		case ST7735_ORIENT_270:
			writeData(display, 0x68);
			break;
		default:
			writeData(display, 0xC8);
			break;
		}

	cs_high(display);
}

void display_DrawPixel(display_device_t display, uint8_t x, uint8_t y, uint16_t color){
	if(x>=display.width||y>=display.height)return;

	setWindow(display, x, y, x, y);
	uint8_t b0 = (uint8_t)(color>>8);
	uint8_t b1 = (uint8_t)color;

	data_mode(display);
	cs_low(display);
	writeData(display, b0);
	writeData(display, b1);
	cs_high(display);
}

void display_DrawLine(display_device_t display, uint8_t x0, uint8_t x1, uint8_t y0, uint8_t y1, uint16_t color){

	int16_t dx = (x1>x0) ? (x1-x0) : (x0-x1);
	int16_t dy = -((y1>y0) ? (y1-y0) : (y0-y1));
	int16_t sx = (x0<x1) ? 1 : -1;
	int16_t sy = (y0<y1) ? 1 : -1;
	int16_t err = dx + dy;

	while(1){
		display_DrawPixel(display, x0, y0, color);
		if(x0==x1 && y0==y1)break;
		int16_t e2 = 2*err;
		if(e2>=dy){err+=dy; x0+=sx;}
		if(e2<=dx){err+=dx; y0+=sy;}
	}
}

void display_DrawRect(display_device_t display, uint8_t x, uint8_t y, uint8_t w, uint8_t h, uint16_t color){
	display_DrawLine(display, x, y, x+w, y, color);
	display_DrawLine(display, x, y+h, x+w, y+h, color);
	display_DrawLine(display, x, y, x, y+h, color);
	display_DrawLine(display, x+w, y, x+w, y+h, color);
}

void display_FillCircle(display_device_t display, uint16_t x, uint16_t y, uint16_t r, uint16_t color){
	uint16_t half_width = r;
		uint32_t radius_squared = (uint32_t)r*r;
		for(uint32_t row_offset = 0; row_offset<=r; row_offset++){
			while((uint32_t)half_width*half_width + (uint32_t)row_offset*row_offset > radius_squared){
				half_width--;
			}
			uint32_t span_x = x - half_width;
			uint32_t span_width = (uint32_t)(2*half_width + 1);

			display_FillRect(display, (uint8_t)span_x, (uint8_t)(y-row_offset), span_width, 1, color);

			if(row_offset>0){
				display_FillRect(display, (uint8_t)span_x, (uint8_t)(y+row_offset), span_width, 1, color);
			}
		}
}

void display_DrawChar(display_device_t display, uint8_t x, uint8_t y, char c, uint16_t color, uint8_t scale){
	if (c<32 || c>126)return;

	const uint8_t *glyph = font5x7[c-32];

	for (uint8_t col=0; col<5; col++){
		uint8_t column_bits = glyph[col];
		for(uint8_t row=0; row<7; row++){
			if(column_bits & (1U<<row)){
				if(scale==1){
					display_DrawPixel(display, x+col, y+row, color);
				}
				else{
					display_FillRect(display, x+col*scale, y+row*scale, scale, scale, color);
				}
			}
		}
	}

}

void display_DrawString(display_device_t display, uint8_t x, uint8_t y, const char *str, uint16_t color, uint8_t scale){
	while(*str){
		display_DrawChar(display, x, y, *str, color, scale);
		x += 6*scale; //5columns + 1space, scaled
		str++;
	}
}












