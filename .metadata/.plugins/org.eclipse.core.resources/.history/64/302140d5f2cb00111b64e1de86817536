#include "st7735.h"
#include "mhal.h"

static void command_mode(display_device_t display){
	HAL_GPIO_WritePin(display.dc_port, display.dc_pin, 0); //command
}

static void data_mode(display_device_t display){
	HAL_GPIO_WritePin(display.dc_port, display.dc_pin, 1); //command
}

static void hardware_reset(display_device_t display){
	HAL_GPIO_WritePin(display.res_port, display.res_pin, 0);
	HAL_Delay(50);
	HAL_GPIO_WritePin(display.res_port, display.res_pin, 1);
	HAL_Delay(120);
}

static void cs_low(display_device_t display){
	HAL_GPIO_WritePin(display.cs_port, display.cs_pin, 0);
}

static void cs_high(display_device_t display){
	HAL_GPIO_WritePin(display.cs_port, display.cs_pin, 1);
}

static void writeCmd(display_device_t display, uint8_t cmd){
	command_mode(display);
	//HAL_GPIO_WritePin(display.cs_port, display.cs_pin, 0);
	HAL_SPI_Transmit(display.hspi, &cmd, 1, 100);
	//HAL_GPIO_WritePin(display.cs_port, display.cs_pin, 1);
}

static void writeData(display_device_t display, uint8_t data){
	data_mode(display);
	//HAL_GPIO_WritePin(display.cs_port, display.cs_pin, 0);
	HAL_SPI_Transmit(display.hspi, &data, 1, 100);
	//HAL_GPIO_WritePin(display.cs_port, display.cs_pin, 1);
}

static uint8_t x_offset(display_device_t display){
	if(display.width==128 && display.height==128){return 5U;}
}

static uint8_t y_offset(display_device_t display){
	if(display.width==128 && display.height==128){return 5U;}
}

static void setWindow(display_device_t display, uint8_t x0, uint8_t y0, uint8_t x1, uint8_t y1){
	writeCmd(display, 0x2A); //column address set
	writeData(display, 0x00); writeData(display, x0 + x_offset(display));
	writeData(display, 0x00); writeData(display, x1 + x_offset(display));

	writeCmd(display, 0x2B); //row address set
	writeData(display, 0x00); writeData(display, y0 + y_offset(display));
	writeData(display, 0x00); writeData(display, y1 + y_offset(display));

	writeCmd(display, 0x2C); //memory write
}

