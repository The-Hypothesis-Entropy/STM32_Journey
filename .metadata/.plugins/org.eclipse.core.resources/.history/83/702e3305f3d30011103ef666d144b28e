void ET_ADC_config(uint8_t *adc_config){
/*
 * PAYLOAD: [ADC NUM][PRESCALER][CHANNEL ENCODING]
 * PRESCALER:
 *   	 0 -> ADC_CLOCK_SYNC_PCLK_DIV2
 * 		 1 -> ADC_CLOCK_SYNC_PCLK_DIV4
 * 		 2 -> ADC_CLOCK_SYNC_PCLK_DIV6
 * 		 3 -> ADC_CLOCK_SYNC_PCLK_DIV8
 */
	__HAL_RCC_ADC1_CLK_ENABLE();
	__HAL_RCC_GPIOA_CLK_ENABLE();
	uint8_t numOfChannels = ((adc_config[2]>>8)&1U) + ((adc_config[2]>>7)&1U) + ((adc_config[2]>>6)&1U) + ((adc_config[2]>>5)&1U) + ((adc_config[2]>>4)&1U) + ((adc_config[2]>>3)&1U) + ((adc_config[2]>>2)&1U) + ((adc_config[2]>>1)&1U) + ((adc_config[2]>>0)&1U);
ADC_HandleTypeDef hadc = {0};
hadc.Instance = ADC1;
hadc.Init.ClockPrescaler = (adc_config[1]==0) ? ADC_CLOCK_SYNC_PCLK_DIV2 :
						   (adc_config[1]==1) ? ADC_CLOCK_SYNC_PCLK_DIV4 :
		                   (adc_config[1]==2) ? ADC_CLOCK_SYNC_PCLK_DIV6 : ADC_CLOCK_SYNC_PCLK_DIV8;
hadc.Init.ScanConvMode = ENABLE; //multi-channel
hadc.Init.NbrOfConversion = numOfChannels; //two channels
hadc.Init.ContinuousConvMode = DISABLE; //one shot
ADC_ChannelConfTypeDef ch = {0};
ch.SamplingTime = ADC_SAMPLETIME_56CYCLES;

GPIO_InitTypeDef gpio = {0}; gpio.Mode = GPIO_MODE_ANALOG; gpio.Pull = GPIO_NOPULL;
uint8_t rank = 1;
if(adc_config[2]&(1<<0U)){ch.Channel = ADC_CHANNEL_0; ch.Rank = rank++; HAL_ADC_ConfigChannel(&hadc, &ch); gpio.Pin |= GPIO_PIN_0;}
if(adc_config[2]&(1<<1U)){ch.Channel = ADC_CHANNEL_1; ch.Rank = rank++; HAL_ADC_ConfigChannel(&hadc, &ch); gpio.Pin |= GPIO_PIN_1;}
if(adc_config[2]&(1<<2U)){ch.Channel = ADC_CHANNEL_2; ch.Rank = rank++; HAL_ADC_ConfigChannel(&hadc, &ch); gpio.Pin |= GPIO_PIN_2;}
if(adc_config[2]&(1<<3U)){ch.Channel = ADC_CHANNEL_3; ch.Rank = rank++; HAL_ADC_ConfigChannel(&hadc, &ch); gpio.Pin |= GPIO_PIN_3;}
if(adc_config[2]&(1<<4U)){ch.Channel = ADC_CHANNEL_4; ch.Rank = rank++; HAL_ADC_ConfigChannel(&hadc, &ch); gpio.Pin |= GPIO_PIN_4;}
if(adc_config[2]&(1<<5U)){ch.Channel = ADC_CHANNEL_5; ch.Rank = rank++; HAL_ADC_ConfigChannel(&hadc, &ch); gpio.Pin |= GPIO_PIN_5;}
if(adc_config[2]&(1<<6U)){ch.Channel = ADC_CHANNEL_6; ch.Rank = rank++; HAL_ADC_ConfigChannel(&hadc, &ch); gpio.Pin |= GPIO_PIN_6;}
if(adc_config[2]&(1<<7U)){ch.Channel = ADC_CHANNEL_7; ch.Rank = rank++; HAL_ADC_ConfigChannel(&hadc, &ch); gpio.Pin |= GPIO_PIN_7;}

HAL_GPIO_Init(GPIOA, &gpio);
}

void ET_TIM_config(uint8_t *tim_config){
	/*
	 *  PACKET: [TIM NUMBER][MODE][CHANNEL][DTHz3][DTHz2][DTHz1][DTHz0][ARR3][ARR2][ARR1][ARR0][CCR3]CCR2][CCR1][CCR0]
	 *  mode: basic -> 0, pwm -> 1, capture -> 2
	 */
	TIM_TypeDef *TIMx = (tim_config[0]==1) ? TIM1:
						(tim_config[0]==2) ? TIM2:
						(tim_config[0]==3) ? TIM3:
						(tim_config[0]==4) ? TIM4:
						(tim_config[0]==5) ? TIM5:
						(tim_config[0]==9) ? TIM9:
						(tim_config[0]==10) ? TIM10: TIM11;
	uint8_t mode = tim_config[1];
	uint8_t channel = tim_config[2];
	uint32_t desired_tick_hz, arr, ccr;
	desired_tick_hz = (tim_config[3]<<24U) | (tim_config[4]<<16U) | (tim_config[5]<<8U) | (tim_config[6]<<0U);
	arr = (tim_config[7]<<24U) | (tim_config[8]<<16U) | (tim_config[9]<<8U) | (tim_config[10]<<0U);
	ccr = (tim_config[11]<<24U) | (tim_config[12]<<16U) | (tim_config[13]<<8U) | (tim_config[14]<<0U);

	uint32_t timclk = SystemCoreClock;
	uint32_t ppre;
	IRQn_Type irqn;


	/* 1. Enable the correct clock and determine which APB prescaler applies */
	    if (TIMx == TIM1) {
	        RCC->APB2ENR |= RCC_APB2ENR_TIM1EN;
	        ppre = (RCC->CFGR >> RCC_CFGR_PPRE2_Pos) & 0x7U;
	    } else if (TIMx == TIM2) {
	        RCC->APB1ENR |= RCC_APB1ENR_TIM2EN;
	        ppre = (RCC->CFGR >> RCC_CFGR_PPRE1_Pos) & 0x7U;
	    } else if (TIMx == TIM3) {
	        RCC->APB1ENR |= RCC_APB1ENR_TIM3EN;
	        ppre = (RCC->CFGR >> RCC_CFGR_PPRE1_Pos) & 0x7U;
	    } else if (TIMx == TIM4) {
	        RCC->APB1ENR |= RCC_APB1ENR_TIM4EN;
	        ppre = (RCC->CFGR >> RCC_CFGR_PPRE1_Pos) & 0x7U;
	    } else if (TIMx == TIM5) {
	        RCC->APB1ENR |= RCC_APB1ENR_TIM5EN;
	        ppre = (RCC->CFGR >> RCC_CFGR_PPRE1_Pos) & 0x7U;
	    }
	    else{ //TIM2 is default
	    	TIMx = TIM2;
	    	RCC->APB1ENR |= RCC_APB1ENR_TIM2EN;
	    	ppre = (RCC->CFGR >> RCC_CFGR_PPRE1_Pos) & 0x7U;
	    }

	    TIMx->CR1 &= ~TIM_CR1_CEN;

	    /* Apply the APB prescaler doubling rule to get the actual timer clock */
	    if (ppre & 0x4U) {  /* prescaler is not divide-by-1 */
	        timclk = (SystemCoreClock >> ((ppre & 0x3U) + 1U)) * 2U;
	    }
		/* 2. Common base: prescaler and auto-reload */
		if (desired_tick_hz == 0 || desired_tick_hz > timclk) {
			desired_tick_hz = timclk;   // fall back to no prescale
		}
		if (ccr > arr) ccr = arr + 1;
		uint32_t psc = (timclk / desired_tick_hz) - 1U;
		TIMx->PSC = psc;
		TIMx->ARR = arr;

		/* 3. Mode-specific configuration */
		switch (mode) {
		case TIM_MODE_BASIC:
			TIMx->CR1 &= ~TIM_CR1_CEN;
			TIMx->DIER |= TIM_DIER_UIE;
			if(channel<=2){
				TIMx->CCMR1 &= ~((TIM_CCMR1_CC1S | TIM_CCMR1_OC1M)<<((channel-1)*8U));
				TIMx->CCMR1 |= (0x3UL << (TIM_CCMR1_OC1M_Pos+((channel-1)*8U)));
				TIMx->CCMR1 &= ~(TIM_CCMR1_OC1PE<<((channel-1)*8U));
			}
			else{
				TIMx->CCMR2 &= ~((TIM_CCMR2_CC3S | TIM_CCMR2_OC3M)<<((channel-1)*8U));
				TIMx->CCMR2 |= (0x3UL << (TIM_CCMR2_OC3M_Pos+((channel-1)*8U)));
				TIMx->CCMR2 &= ~(TIM_CCMR2_OC3PE<<((channel-1)*8U));
			}
			TIMx->CCER &= ~(TIM_CCER_CC1P<<((channel-1U)*4U));   /* Active high */
			TIMx->CCER |= TIM_CCER_CC1E<<((channel-1U)*4U);    /* Enable channel output */
			if(channel==1U)TIMx->CCR1 = 1U; //toggle_at;
			else if(channel==2U)TIMx->CCR2 = 1U;
			else if(channel==3U)TIMx->CCR3 = 1U;
			else TIMx->CCR4 = 1U;
			TIMx->EGR |= TIM_EGR_UG;
			TIMx->SR &= ~TIM_SR_UIF;        /* Clear the update flag */
			break;

		case TIM_MODE_PWM:
			TIMx->CR1 &= ~TIM_CR1_CEN;
			if(channel<=2U){
				TIMx->CCMR1 &= ~(TIM_CCMR1_OC1M << ((channel-1)*8U));
				TIMx->CCMR1 |= (0x6UL << (TIM_CCMR1_OC1M_Pos + (channel-1)*8U));   /* PWM mode 1 */
				TIMx->CCMR1 |= TIM_CCMR1_OC1PE<<((channel-1)*8U);                 /* preload enable */
				TIMx->CCMR1 &= ~(TIM_CCMR1_CC1S<<((channel-1)*8U));   /* CC1S = 00 → output */
			}
			else{
				TIMx->CCMR2 &= ~(TIM_CCMR2_OC3M << ((channel-1)*8U));
				TIMx->CCMR2 |= (0x6UL << (TIM_CCMR2_OC3M_Pos + (channel-1)*8U));   /* PWM mode 1 */
				TIMx->CCMR2 |= TIM_CCMR2_OC3PE<<((channel-1)*8U);                 /* preload enable */
				TIMx->CCMR2 &= ~(TIM_CCMR2_CC3S<<((channel-1)*8U));   /* CC1S = 00 → output */
			}
			if(channel==1U)TIMx->CCR1 = ccr;
			else if(channel==2U)TIMx->CCR2 = ccr;
			else if(channel==3U)TIMx->CCR3 = ccr;
			else TIMx->CCR4 = ccr;
			TIMx->CCER &= ~(TIM_CCER_CC1P<<((channel-1U)*4U));   /* Active high */
			TIMx->CCER |= TIM_CCER_CC1E<<((channel-1U)*4U);    /* Enable channel output */
			TIMx->CR1   |= TIM_CR1_ARPE;
			TIMx->EGR   |= TIM_EGR_UG;
			TIMx->SR    &= ~TIM_SR_UIF;

			break;

		case TIM_MODE_CAPTURE:
			TIMx->CR1 &= ~TIM_CR1_CEN;
			if(channel<=2){
				TIMx->CCMR1 &= ~(TIM_CCMR1_CC1S<<((channel-1U)*8U));
				TIMx->CCMR1 |= (0x1UL << (TIM_CCMR1_CC1S_Pos+((channel-1)*8U)));   /* CC1S = 01 (TI1) */
			}
			else{
				TIMx->CCMR2 &= ~(TIM_CCMR2_CC3S<<((channel-1U)*8U));
				TIMx->CCMR2 |= (0x1UL << (TIM_CCMR2_CC3S_Pos+((channel-1)*8U)));   /* CC1S = 01 (TI1) */

			}
			TIMx->DIER  |= (TIM_DIER_CC1IE<<(channel-1U));
			TIMx->CCER  |= TIM_CCER_CC1E<<((channel-1U)*4U);
			TIMx->SR    &= ~(TIM_SR_CC1IF<<(channel-1U));
			TIMx->CCER &= ~(TIM_CCER_CC1P | TIM_CCER_CC1NP);  /* rising edge */
			break;
		}
		if (TIMx == TIM1) {
			TIMx->BDTR |= TIM_BDTR_MOE;
		}
		NVIC_EnableIRQ(irqn);   /* or whichever timer */

		/* 4. Start the counter */
		TIMx->CR1 |= TIM_CR1_CEN;

		/* 5. Config the channel */
		GPIO_InitTypeDef gpio = {0};
		gpio.Mode = GPIO_MODE_AF_PP;
		gpio.Pull = GPIO_NOPULL;
		gpio.Speed = GPIO_SPEED_FREQ_LOW;
		switch(tim_config[0]){
		case 1: //TIM1
			switch(channel){ //channel
			case 2:
				gpio.Pin = GPIO_PIN_9;
				gpio.Alternate = GPIO_AF1_TIM2;
				break;
			case 3:
				gpio.Pin = GPIO_PIN_10;
				gpio.Alternate = GPIO_AF1_TIM2;
				break;
			case 4:
				gpio.Pin = GPIO_PIN_11;
				gpio.Alternate = GPIO_AF1_TIM2;
				break;
			default:
				gpio.Pin = GPIO_PIN_8;
				gpio.Alternate = GPIO_AF1_TIM2;
				break;
			}
			HAL_GPIO_Init(GPIOA, &gpio);
			break;

		case 3:
			switch(channel){ //channel
					case 2:
						gpio.Pin = GPIO_PIN_7;
						gpio.Alternate = GPIO_AF2_TIM3;
						HAL_GPIO_Init(GPIOA, &gpio);
						break;
					case 3:
						gpio.Pin = GPIO_PIN_0;
						gpio.Alternate = GPIO_AF2_TIM3;
						HAL_GPIO_Init(GPIOB, &gpio);
						break;
					case 4:
						gpio.Pin = GPIO_PIN_1;
						gpio.Alternate = GPIO_AF2_TIM3;
						HAL_GPIO_Init(GPIOB, &gpio);
						break;
					default:
						gpio.Pin = GPIO_PIN_6;
						gpio.Alternate = GPIO_AF2_TIM3;
						HAL_GPIO_Init(GPIOA, &gpio);
						break;
					}
			break;

		case 4:
			switch(channel){ //channel
					case 2:
						gpio.Pin = GPIO_PIN_7;
						gpio.Alternate = GPIO_AF2_TIM4;
						HAL_GPIO_Init(GPIOB, &gpio);
						break;
					case 3:
						gpio.Pin = GPIO_PIN_8;
						gpio.Alternate = GPIO_AF2_TIM4;
						HAL_GPIO_Init(GPIOB, &gpio);
						break;
					case 4:
						gpio.Pin = GPIO_PIN_9;
						gpio.Alternate = GPIO_AF2_TIM4;
						HAL_GPIO_Init(GPIOB, &gpio);
						break;
					default:
						gpio.Pin = GPIO_PIN_6;
						gpio.Alternate = GPIO_AF2_TIM4;
						HAL_GPIO_Init(GPIOB, &gpio);
						break;
					}
			break;

		case 5:
			switch(channel){ //channel
					case 2:
						gpio.Pin = GPIO_PIN_1;
						gpio.Alternate = GPIO_AF2_TIM5;
						HAL_GPIO_Init(GPIOA, &gpio);
						break;
					case 3:
						gpio.Pin = GPIO_PIN_2;
						gpio.Alternate = GPIO_AF2_TIM5;
						HAL_GPIO_Init(GPIOA, &gpio);
						break;
					case 4:
						gpio.Pin = GPIO_PIN_3;
						gpio.Alternate = GPIO_AF2_TIM5;
						HAL_GPIO_Init(GPIOA, &gpio);
						break;
					default:
						gpio.Pin = GPIO_PIN_0;
						gpio.Alternate = GPIO_AF2_TIM5;
						HAL_GPIO_Init(GPIOA, &gpio);
						break;
					}
			break;
	//can be extended. but my personal use may already burden timers 9, 10, 11
		}
