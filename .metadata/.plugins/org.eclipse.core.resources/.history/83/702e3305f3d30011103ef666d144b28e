//PERIPHERAL ACCESS AND CONTROL

void ET_GPIO_write(uint8_t *gpio_settings){
/*
 * ARRAY: [PORT LETTER][GPIO NUM][VALUE]
 */
	GPIO_TypeDef *port;
	if(gpio_settings[0]=='B'){port = GPIOB;}
	else if(gpio_settings[0]=='C'){port = GPIOC;}
	else if(gpio_settings[0]=='D'){port = GPIOD;}
	else{port = GPIOA;}

	HAL_GPIO_WritePin(port, (uint16_t)(0x0001<<gpio_settings[1]), gpio_settings[2]);
}

uint8_t ET_GPIO_read(uint8_t *gpio_settings){
/*
 * ARRAY: [PORT LETTER][GPIO NUM]
 */
	GPIO_TypeDef *port;
	if(gpio_settings[0]=='B'){port = GPIOB;}
	else if(gpio_settings[0]=='C'){port = GPIOC;}
	else if(gpio_settings[0]=='D'){port = GPIOD;}
	else{port = GPIOA;}

	return HAL_GPIO_ReadPin(port, (uint16_t)(0x0001<<gpio_settings[1]));
}


void ET_UART_send(uint8_t *param){
/*
 * ARRAY: [UART NUM][LENGTH OF DATA][DATA begin]...[DATA end]
 */

	USART_TypeDef *uart = (param[0]==1U) ? USART1 : (param[0] == 2U) ? USART2 : USART6;
	for(uint16_t i = 0; i<param[1]; i++){
		while(!(uart->SR & USART_SR_TXE)){}
		uart->DR = param[i+2];
	}
}

void ET_UART_recv(uint8_t *param){
/*
 * ARRAY: [UART NUM][LENGTH OF DATA][ET_TypeUARTReceive]
 */

	USART_TypeDef *uart = (param[0]==1U) ? USART1 : (param[0] == 2U) ? USART2 : USART6;
	for(uint16_t i = 0; i<param[1]; i++){ //mhal_gpio_on(PA5); // mhal_uart_write(USART2, param, param[1]);
		while (!(uart->SR & USART_SR_RXNE));
			param[i+3] = uart->DR;
			mhal_uart_write_byte(USART2, param[i+3]);
	}

}

void ET_ADC_read(uint8_t *param){
	uint8_t adc, ch;
	adc = param[0]; ch = param[1];
	param[0] = param[2];

	 /* Single conversion: sequence length = 1 (L field = 0) */
	    ADC1->SQR1 = 0;

	    /* Put the requested channel in slot 1 */
	    ADC1->SQR3 = (ch & 0x1FU);

	    /* Sample time: 84 cycles (SMP bits = 100) for that channel */
	    if (ch < 10) {
	        ADC1->SMPR2 &= ~(7U << (ch * 3U));
	        ADC1->SMPR2 |=  (4U << (ch * 3U));
	    } else {
	        uint8_t n = ch - 10U;
	        ADC1->SMPR1 &= ~(7U << (n * 3U));
	        ADC1->SMPR1 |=  (4U << (n * 3U));
	    }

	    /* Make sure nothing else steals DR or keeps converting */
	    ADC1->CR2 &= ~(ADC_CR2_CONT | ADC_CR2_DMA | ADC_CR2_DDS);

	    /* Clear any stale EOC by reading DR */
	    (void)ADC1->DR;

	    /* Start the conversion */
	    ADC1->CR2 |= ADC_CR2_SWSTART;

	    /* Wait for end of conversion */
	    while (!(ADC1->SR & ADC_SR_EOC)) {
	        /* spin */
	    }

	/* 4. Read and return the result */
	uint16_t data = (uint16_t)ADC1->DR;   // 12-bit value (0..4095)

	param[1] = (uint8_t)((data>>8)&0xFF); param[2] = (uint8_t)((data>>0)&0xFF);

	}













