//------------------------------------------------------------------------

void mhal_adc_init(ADC_TypeDef *adc, const char* pin_name){
	//CLOCK ENABLE
	RCC->APB2ENR |= RCC_APB2ENR_ADC1EN;

	mhal_adc_config_t config = MHAL_ADC_CFG_DEFAULT;
	//PRESCALER CONFIG
	ADC_Common_TypeDef *gen_adc = ADC1_COMMON;
	gen_adc->CCR &= ~ADC_CCR_ADCPRE_Msk;
	gen_adc->CCR |= (config.prescaler)<<ADC_CCR_ADCPRE_Pos;

	//RESOLUTION
	adc->CR1 &= ~ADC_CR1_RES_Msk;
	adc->CR1 |= (config.resolution)<<ADC_CR1_RES_Pos;

	//CHANNEL CONFIG
	adc->SQR3 &= ~ADC_SQR3_SQ1_Msk;
	adc->SQR3 |= (config.channel)<<ADC_SQR3_SQ1_Pos;

	//SAMPLE TIME (first channel only)
	adc->SMPR2 &= ~(ADC_SMPR2_SMP0_Msk<<(config.channel * 3U));
	adc->SMPR2 |= (config.sample_time)<<(config.channel * 3U);

	//SCAN MODE ENABLED (cycle through input channels converting each one)
	adc->CR1 |= ADC_CR1_SCAN;

	//CONTINOUS MODE ENABLED (keep reading the enabled channel(s))
	adc->CR2 |= ADC_CR2_CONT;

	//ADC ON
	adc->CR2 |= ADC_CR2_ADON;
}

uint32_t mhal_adc_read(ADC_TypeDef *adc){
	//adc->SR &= ~ADC_SR_EOC; race?
	(void)adc->DR; //atomic, and clears EOC

	adc->CR2 |= ADC_CR2_SWSTART;
	while(!(adc->SR & ADC_SR_EOC)){}
	return adc->DR;
}
