/*
 * ADC:
 */

ADC_HandleTypeDef *hadc = NULL;
uint8_t numberOfADCChannels = 0;
void adc_init(uint8_t numOfChannels){
	/*
	 * ONLY FOR CHANNELS 0-7 (A0 - A7)
	 */
	__HAL_RCC_ADC1_CLK_ENABLE();
	__HAL_RCC_GPIOA_CLK_ENABLE();

	hadc->Instance = ADC1;
	hadc->Init.ClockPrescaler = ADC_CLOCK_SYNC_PCLK_DIV4;
	hadc->Init.ScanConvMode = ENABLE; //multi-channel
	hadc->Init.NbrOfConversion = numOfChannels; //two channels
	hadc->Init.ContinuousConvMode = DISABLE; //one shot
	HAL_ADC_Init(hadc);
	numberOfADCChannels = numOfChannels;

	ADC_ChannelConfTypeDef ch = {0};
	ch.SamplingTime = ADC_SAMPLETIME_56CYCLES;
	ch.Channel = ADC_CHANNEL_0; ch.Rank = 1; HAL_ADC_ConfigChannel(hadc, &ch);

	GPIO_InitTypeDef gpio = {0}; gpio.Mode = GPIO_MODE_ANALOG; gpio.Pull = GPIO_NOPULL;
	switch(numOfChannels){
	case 8:
		ch.Channel = ADC_CHANNEL_7; ch.Rank = 8; HAL_ADC_ConfigChannel(hadc, &ch);
		gpio.Pin |= GPIO_PIN_7;
	case 7:
		ch.Channel = ADC_CHANNEL_6; ch.Rank = 7; HAL_ADC_ConfigChannel(hadc, &ch);
		gpio.Pin |= GPIO_PIN_6;
	case 6:
		ch.Channel = ADC_CHANNEL_5; ch.Rank = 6; HAL_ADC_ConfigChannel(hadc, &ch);
		gpio.Pin |= GPIO_PIN_5;
	case 5:
		ch.Channel = ADC_CHANNEL_4; ch.Rank = 5; HAL_ADC_ConfigChannel(hadc, &ch);
		gpio.Pin |= GPIO_PIN_4;
	case 4:
		ch.Channel = ADC_CHANNEL_3; ch.Rank = 4; HAL_ADC_ConfigChannel(hadc, &ch);
		gpio.Pin |= GPIO_PIN_3;
	case 3:
		ch.Channel = ADC_CHANNEL_2; ch.Rank = 3; HAL_ADC_ConfigChannel(hadc, &ch);
		gpio.Pin |= GPIO_PIN_2;
	case 2:
		ch.Channel = ADC_CHANNEL_1; ch.Rank = 2; HAL_ADC_ConfigChannel(hadc, &ch);
		gpio.Pin |= GPIO_PIN_1;
	default:
		ch.Channel = ADC_CHANNEL_0; ch.Rank = 1; HAL_ADC_ConfigChannel(hadc, &ch);
		gpio.Pin |= GPIO_PIN_0;
	}

	HAL_GPIO_Init(GPIOA, &gpio);
}

void adc_read(uint16_t *results){
	HAL_ADC_Start(hadc);
	for(uint8_t i = 0; i<numberOfADCChannels; i++){
		HAL_ADC_PollForConversion(hadc, 10);
		results[i] = (uint16_t)HAL_ADC_GetValue(hadc);
	}
	HAL_ADC_Stop(hadc);
}



