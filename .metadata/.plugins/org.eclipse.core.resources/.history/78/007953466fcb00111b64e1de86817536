/*
 * TIMERS:
 */

/* 1. Globals */
TIM_HandleTypeDef htim = {0};

/* 2. Init function (fills the struct) */
void tim_init(void) {
    htim.Instance = TIM2;
    htim.Init.Prescaler = 8399;      // 84MHz / 8400 = 10kHz (0.1ms per tick)
    htim.Init.Period = 9999;         // 10kHz / 10000 = 1Hz (1 second)
}

/* 3. Main */
int main(void) {
    HAL_Init();

    __HAL_RCC_TIM2_CLK_ENABLE();

    tim_init();
    HAL_TIM_Base_Init(&htim);

    // Enable interrupt in NVIC and start timer with interrupt
    HAL_NVIC_EnableIRQ(TIM2_IRQn);
    HAL_TIM_Base_Start_IT(&htim);

    while(1) {}
}

// In stm32f4xx_it.c (or wherever your handlers are):
void TIM2_IRQHandler(void) {
    HAL_TIM_IRQHandler(&htim);
}
