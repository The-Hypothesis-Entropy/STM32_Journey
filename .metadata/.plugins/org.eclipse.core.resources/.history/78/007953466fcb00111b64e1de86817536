//YOU CHANGE THAT VAR IN MAIN, BUT NOT THE ACTUAL CONFIG VAR YOU DEALT WITH HERE
//THAT DISCREPANCY CAN CAUSE BUGS

UART_HandleTypeDef huart1 = {0};
UART_HandleTypeDef huart2 = {0};
UART_HandleTypeDef huart6 = {0};
UART_HandleTypeDef *huart = NULL;
UART_HandleTypeDef *uart_init(USART_TypeDef *uart){
	huart = (uart==USART1) ? &huart1 : ((uart==USART2) ? &huart2 : &huart6);

	IRQn_Type irqn = USART2_IRQn;
	huart->Instance = uart;
	huart->Init.BaudRate = 115200;
	huart->Init.Mode = UART_MODE_TX_RX;
	//HAL_UART_Init(&huart); ONLY DO AFTER CLOCK IS ACTIVATED!

	GPIO_InitTypeDef gpio = {0};
#ifdef USART1
	if(uart==USART1){
	__HAL_RCC_USART1_CLK_ENABLE();
	__HAL_RCC_GPIOA_CLK_ENABLE();

	gpio.Pin = GPIO_PIN_9 | GPIO_PIN_10;
	gpio.Mode = GPIO_MODE_AF_PP;
	gpio.Pull = GPIO_PULLUP;
	gpio.Speed = GPIO_SPEED_FREQ_HIGH;
	gpio.Alternate = GPIO_AF7_USART1;
	HAL_GPIO_Init(GPIOA, &gpio);
	irqn = USART1_IRQn;
	}
#endif
#ifdef USART2
	if(uart==USART2){
	__HAL_RCC_USART2_CLK_ENABLE();
	__HAL_RCC_GPIOA_CLK_ENABLE();

	gpio.Pin = GPIO_PIN_2 | GPIO_PIN_3;
	gpio.Mode = GPIO_MODE_AF_PP;
	gpio.Pull = GPIO_PULLUP;
	gpio.Speed = GPIO_SPEED_FREQ_HIGH;
	gpio.Alternate = GPIO_AF7_USART2;
	HAL_GPIO_Init(GPIOA, &gpio);
	irqn = USART2_IRQn;
	}
#endif
#ifdef USART6
	if(uart==USART6){
	__HAL_RCC_USART6_CLK_ENABLE();
	__HAL_RCC_GPIOA_CLK_ENABLE();

	gpio.Pin = GPIO_PIN_11 | GPIO_PIN_12;
	gpio.Mode = GPIO_MODE_AF_PP;
	gpio.Pull = GPIO_PULLUP;
	gpio.Speed = GPIO_SPEED_FREQ_HIGH;
	gpio.Alternate = GPIO_AF8_USART6;
	HAL_GPIO_Init(GPIOA, &gpio);
	irqn = USART6_IRQn;
	}
#endif
	HAL_UART_Init(huart);
	NVIC_EnableIRQ(irqn);
	return huart;
}

void USART1_IRQHandler(void){HAL_UART_IRQHandler(huart);}
void USART2_IRQHandler(void){HAL_UART_IRQHandler(huart);}
void USART6_IRQHandler(void){HAL_UART_IRQHandler(huart);}

