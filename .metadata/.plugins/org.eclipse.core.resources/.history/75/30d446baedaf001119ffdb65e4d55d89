#include "stm32f401xe.h"
#include "mhal.h"


int main_one(){
	//Enable the power to GPIOA
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOCEN;

	//Config PA5
	GPIOA->MODER |= 0x01<<10;

	//Config PC13


	while(1){
		if(GPIOC->IDR & 0x01<<13){
			GPIOA->BSRR = 0x01<<5;
		}
		else{
			GPIOA->BSRR = 0x01<<(5+16);
		}
	}
}

int main_one_example(){
	//Activate GPIOB
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;

	//Configure PB3
	GPIOB->MODER &= ~(0x11<<6);
	GPIOB->MODER |= 0x01<<6;

	GPIOB->OTYPER |= 0x01<<3;

	//Pull PB3 low
	GPIOB->BSRR = 0x01<<(3+16);
}

int main_interrupt_one(){
	//Power up GPIOA
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
	//Configure PA5
	GPIOA->MODER |= 0x01<<10;

	//Power up GPIOC
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOCEN;
	//Configure PC13
	//defaults from reset are fine

	//Interrupt Workflow: SYSCFG, EXTI, NVIC, Handler

	//SYSCFG config
	RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN; //Power enabled
	SYSCFG->EXTICR[3] |= 0x01<<5; //Choose port c to supply t

	//EXTI config
	EXTI->IMR |= 0x01<<13; //unmask line 13, allow EXTI to send requests to the NVIC
	EXTI->FTSR |= 0x01<<13; //falling edge for line 13 to be observed by NVIC
	//EXTI will automatically set pending bit when the edge change is detected.!

	//NVIC config
	NVIC_EnableIRQ(EXTI15_10_IRQn); //EXTI line allowed to get cpu attention
	NVIC_SetPriority(EXTI15_10_IRQn, 0); //with respect to other tasks.

	while(1){}

//PLACE OUTSIDE OF MAIN
	void EXTI15_10_IRQHandler(void){
		if(EXTI->PR & 0x01<<13){ //confirm it was line 13 that made the call
			//CLEAR THE PENDING FLAG!!!!
			EXTI->PR |= 0x01<<13;
			GPIOA->BSRR = (GPIOA->ODR & 0x01<<5) ? (0x01<<(5+16)) : (0x01<<5);
		}
	}
}

int main_hold(){
	//Power and Configure PA5
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
	GPIOA->MODER &= ~(0x03<<10);
	GPIOA->MODER |= 0x01<<10;

	//Power up GPIOB
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;

	//Configure PB0
	GPIOB->MODER &= ~(0x03<<0);
	GPIOB->PUPDR &= ~(0b0011<<0);
	GPIOB->PUPDR |= 0x02<<0;

	//SYSCFG
	RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN; //Power
	SYSCFG->EXTICR[0] &= ~(0x0F);
	SYSCFG->EXTICR[0] |= 0x01; //Choose what port connects to exti0

	//EXTI
	EXTI->IMR |= (0x01<<0); //EXTI0 line unmasked, permitted to request to nvic
	EXTI->RTSR |= 0x01<<0; //Rising edge to be observed for by EXTI
	//because there is an edge to observe, the pending bit will be set when edge switch occurs
	//because that line is unmasked, exti will fire interrupt request when edge switch observed.
	//exti will wait for handler to SET EXTI->PR as acknowledgment of handling. else will refire
	//once the handler is declared inactive by nvic

	//NVIC
	NVIC_EnableIRQ(EXTI0_IRQn);
	NVIC_SetPriority(EXTI0_IRQn, 0);

	//					DONE: CAKE ICING ON THE HANDLER
	while(1);
}

