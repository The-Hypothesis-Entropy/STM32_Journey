#include "mhal_tim.h"
#include "stm32f401xe.h"

/*
 * 1. TIMER CLOCK ARRIVES FROM RCC
 * 2. PSC DIVIDES CLOCK TO OBTAIN COUNT CLOCK
 * 3. THE COUNT REGISTER COUNTS ACCORDING TO THE COUNT CLOCK
 * 4. WHEN 0 OR ARR REACHED, COUNTER RESETS
 * 5. AN UPDATE EVENT FIRES WHEN COUNTER OVERFLOWS OR UNDERFLOWS
 *
 * a. A counter can be in only ONE COUNTING MODE at a time, but
 * 	  its channels (CCRx) can independently do different things.
 *
 * 	  Counting Modes (TIMx->CR1.CMS):
 * 	  	* Edge-aligned up: 0 -> ARR ->RESTART
 * 	  	* Edge-aligned down: ARR -> 0 ->RESTART
 * 	  	* Center-aligned 1: up, then down. alternating. UE on underflow only
 * 	  	* Center-aligned 2: up, then down. alternating. UE on overflow only
 *
 * 	  Channel Modes :
 *
 */
void mhal_tim_base_init(TIM_TypeDef *tim, const mhal_tim_base_config_t *config){

	//Enable timer peripheral's clock
	if(tim==TIM1){RCC->APB2ENR |= RCC_APB2ENR_TIM1EN;}
	if(tim==TIM9){RCC->APB2ENR |= RCC_APB2ENR_TIM9EN;}
	if(tim==TIM10){RCC->APB2ENR |= RCC_APB2ENR_TIM10EN;}
	if(tim==TIM11){RCC->APB2ENR |= RCC_APB2ENR_TIM11EN;}
	if(tim==TIM2){RCC->APB1ENR |= RCC_APB1ENR_TIM2EN;}
	if(tim==TIM3){RCC->APB1ENR |= RCC_APB1ENR_TIM3EN;}
	if(tim==TIM4){RCC->APB1ENR |= RCC_APB1ENR_TIM4EN;}
	if(tim==TIM5){RCC->APB1ENR |= RCC_APB1ENR_TIM5EN;}

	//Read timer's input clock frequency (pure, before PSC applied)
	uint32_t pclk = mhal_tim_get_clock(tim);

	//Stop the timer. if it is already running, writing PSC or ARR (next step) can cause undefined behavior
	tim->CR1 &= ~(TIM_CR1_CEN_Msk);

	//Solve for PSC and ARR (try to make ARR as large as possible, and PSC as small as possible)
	uint32_t max_arr = ((tim==TIM2)||(tim==TIM5)) ? 0xFFFFFFFF : 0xFFFF;

	uint32_t divisor = pclk / config->frequency_hz;
	if (divisor==0U)divisor=1U; //incase requested frequency is too high

	uint32_t psc, arr_plus_1;
	if(divisor<=max_arr+1){
		psc = 0;
		arr_plus_1 = total_divisor - 1U;
	}
	else{
		psc = divisor / (max_arr + 1U);
		if(psc>0xFFFFU)psc=0xFFFFU; //caps at 16bit max
	}











}

static uint32_t mhal_tim_get_clock(TIM_TypeDef *tim){
	//Read system clock frequency
	uint32_t hclk = SystemCoreClock;

	//Identify APB bus on which the timer is
	//on f401re;
	//	APB2: TIM1, TIM9, TIM10, TIM11
	//  APB1: TIM2, TIM3, TIM4, TIM5
	uint32_t ppre_field;
	if((tim==TIM1)||(tim==TIM9)||(tim==TIM10)||(tim==TIM11)){
		ppre_field = ((RCC->CFGR)>>13U) & 7U;
	}
	else if((tim==TIM2)||(tim==TIM3)||(tim==TIM4)||(tim==TIM5)){
		ppre_field = ((RCC->CFGR)>>10) & 7U;
	}

	//Decode 3-bit prescaler field into actual divide factor
	uint32_t psc;
	switch(ppre_field){
	case 4:
		psc = 2U;
		break;
	case 5:
		psc = 4U;
		break;
	case 6:
		psc = 8U;
		break;
	case 7:
		psc = 16U;
		break;
	default:
		psc = 1U;
		break;
	}

	//Compute the bus frequency
	uint32_t pclk = hclk / psc;

	//ST quirk
	if(psc == 1U)return pclk;
	else return pclk*2U;

}
